diff --git a/agent-suites/fixtures/shoe-repair/src/hours.mjs b/agent-suites/fixtures/shoe-repair/src/hours.mjs
new file mode 100644
index 0000000..72553b8
--- /dev/null
+++ b/agent-suites/fixtures/shoe-repair/src/hours.mjs
@@ -0,0 +1,12 @@
+import { readFileSync } from 'node:fs'
+
+/** Days the shop is shut besides Sundays and Mondays: bank holidays and the Christmas break. */
+export const CLOSED = JSON.parse(
+  readFileSync(new URL('../data/closed.json', import.meta.url), 'utf8'),
+)
+
+/** Whether the shop is open on this ISO date: Tuesday to Saturday, except the closed dates. */
+export function isOpen(date, closed = CLOSED) {
+  const weekday = new Date(date).getUTCDay()
+  return weekday >= 2 && weekday <= 6 && !closed.includes(date)
+}
