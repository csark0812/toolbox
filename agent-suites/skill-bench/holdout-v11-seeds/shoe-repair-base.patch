--- /dev/null
+++ b/agent-suites/fixtures/shoe-repair/tests/hours.test.mjs
@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { isOpen } from '../src/hours.mjs'
+
+test('the shop is open Tuesday to Saturday', () => {
+  assert.equal(isOpen('2026-12-15'), true)
+  assert.equal(isOpen('2026-12-19'), true)
+})
+
+test('the shop is shut on Sundays and Mondays', () => {
+  assert.equal(isOpen('2026-12-13'), false)
+  assert.equal(isOpen('2026-12-14'), false)
+})
+
+test('the shop is shut on Christmas Day and Boxing Day', () => {
+  assert.equal(isOpen('2026-12-25'), false)
+  assert.equal(isOpen('2026-12-26'), false)
+})
