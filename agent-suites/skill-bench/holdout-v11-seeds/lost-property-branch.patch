index 0000000..bad52c1
--- /dev/null
+++ b/agent-suites/fixtures/lost-property/src/match.mjs
@@ -0,0 +1,7 @@
+/** Whether a passenger's description names at least two details of the item's hidden marks. */
+export function matchesMarks(description, hiddenMarks) {
+  const marks = hiddenMarks.toLowerCase()
+  const words = description.toLowerCase().split(/\W+/)
+  let hits = words.filter((word) => marks.includes(word)).length
+  return hits >= 2
+}
