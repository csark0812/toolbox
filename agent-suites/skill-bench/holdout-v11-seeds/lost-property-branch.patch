 export const HOLD_DAYS = 28
 
+// Date.parse depends on the runtime for some inputs; build the UTC day from the parts instead.
+const toUtc = (date) => {
+  const [year, month, day] = date.split('-').map(Number)
+  return Date.UTC(year, month - 1, day)
+}
+
