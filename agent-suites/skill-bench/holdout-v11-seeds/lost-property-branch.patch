+
+/** Whether the item has gone to the charity shop. */
+export const goneToCharity = (item, today) => daysSince(item.foundOn, today) > HOLD_DAYS
diff --git a/agent-suites/fixtures/lost-property/src/match.mjs b/agent-suites/fixtures/lost-property/src/match.mjs
