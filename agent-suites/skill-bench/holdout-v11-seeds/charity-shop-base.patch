diff --git a/agent-suites/fixtures/charity-shop/src/sales.mjs b/agent-suites/fixtures/charity-shop/src/sales.mjs
index 7c76024..fcc87de 100644
--- a/agent-suites/fixtures/charity-shop/src/sales.mjs
+++ b/agent-suites/fixtures/charity-shop/src/sales.mjs
@@ -6,3 +6,9 @@ export const takings = (sales) => sales.reduce((sum, sale) => sum + sale.pence,
 
 /** Pence as pounds, for printing: 2400 is `£24.00`. */
 export const pounds = (pence) => `£${(pence / 100).toFixed(2)}`
+
+/** The takings at each shop, in the order the shops first appear. */
+export function byShop(sales) {
+  const shops = [...new Set(sales.map((sale) => sale.shop))]
+  return shops.map((shop) => ({ shop, pence: takings(sales.filter((sale) => sale.shop === shop)) }))
+}
