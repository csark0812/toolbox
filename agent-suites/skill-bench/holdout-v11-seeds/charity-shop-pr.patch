diff --git a/agent-suites/fixtures/charity-shop/tests/giftaid.test.mjs b/agent-suites/fixtures/charity-shop/tests/giftaid.test.mjs
new file mode 100644
index 0000000..c58b93f
--- /dev/null
+++ b/agent-suites/fixtures/charity-shop/tests/giftaid.test.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { claimable, claimOn, claims } from '../src/giftaid.mjs'
+
+const declared = { id: 'D-1', name: 'Ann', declaredOn: '2026-10-14' }
+const undeclared = { id: 'D-2', name: 'Bob', declaredOn: null }
+const sale = (donor, pence, soldOn, kind = 'donated') => ({ item: 'x', kind, donor, pence, soldOn })
+
+test('£40.00 of proceeds claims £10.00', () => {
+  assert.equal(claimOn(4000), 1000)
+})
+
+test('a declaration covers sales from the day it is made', () => {
+  assert.equal(claimable(sale('D-1', 800, '2026-10-14'), declared), true)
+  assert.equal(claimable(sale('D-1', 800, '2026-10-13'), declared), false)
+})
+
+test('nothing is claimed for a donor without a declaration', () => {
+  assert.equal(claimable(sale('D-2', 800, '2026-10-14'), undeclared), false)
+})
+
+test('claims list each declared donor with their proceeds', () => {
+  const sales = [sale('D-1', 1200, '2026-10-15'), sale('D-2', 500, '2026-10-15')]
+  assert.deepEqual(
+    claims(sales, [declared, undeclared]).map((entry) => [entry.donor.id, entry.proceeds]),
+    [['D-1', 1200]],
+  )
+})
