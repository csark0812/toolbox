index 0000000..32fc0a3
--- /dev/null
+++ b/agent-suites/fixtures/charity-shop/src/giftaid.mjs
@@ -0,0 +1,25 @@
+import { forDonor, takings } from './sales.mjs'
+
+// Gift Aid is the basic rate of income tax (20%), which HMRC pays back to the hospice on the
+// money we raise for a donor who has made a Gift Aid declaration.
+export const BASIC_RATE = 0.2
+
+/**
+ * Whether a sale counts towards its donor's Gift Aid: only donated goods, and only once the
+ * donor has made a declaration. A declaration covers sales from the day it is made.
+ */
+export const claimable = (sale, donor) =>
+  sale.kind === 'donated' && donor.declaredOn !== null && sale.soldOn >= donor.declaredOn
+
+/** The Gift Aid we can claim on these proceeds, in pence. */
+export const claimOn = (pence) => Math.round(pence * BASIC_RATE)
+
+/** Each declared donor's proceeds this week and the claim on them, leaving out donors with none. */
+export function claims(sales, donors) {
+  return donors
+    .map((donor) => {
+      const proceeds = takings(forDonor(sales, donor.id).filter((sale) => claimable(sale, donor)))
+      return { donor, proceeds, claim: claimOn(proceeds) }
+    })
+    .filter((entry) => entry.proceeds > 0)
+}
