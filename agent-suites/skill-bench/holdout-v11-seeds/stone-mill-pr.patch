+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { pounds, millingFee } from '../src/fees.mjs'
+
+test('a small bag pays the £5.00 minimum', () => {
+  assert.equal(millingFee(8), 500)
+})
+
+test('20 kg is charged at 40p a kilo', () => {
+  assert.equal(millingFee(20), 800)
+})
+
+test('exactly 50 kg is all in the first band', () => {
+  assert.equal(millingFee(50), 2000)
+})
+
+test('60 kg pays 40p for the first 50 kg and 30p for the other 10', () => {
+  assert.equal(millingFee(60), 2300)
+})
+
+test('fees print as pounds and pence', () => {
+  assert.equal(pounds(2300), '£23.00')
+  assert.equal(pounds(500), '£5.00')
+})
