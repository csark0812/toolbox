+// Milling is charged by weight, in pence: 40p a kilo for the first 50 kg and 30p a kilo
+// after that, with a £5.00 minimum so a small sack still covers dressing the stones.
+export const MINIMUM = 500
+export const FIRST_BAND_KG = 50
+
+/** The milling fee for this many kilos, in whole pence. */
+export function millingFee(kg) {
+  const rate = kg > FIRST_BAND_KG ? 30 : 40
+  return Math.max(MINIMUM, Math.round(kg * rate))
+}
+
+/** Pence as pounds, for printing: 2300 is `£23.00`. */
+export const pounds = (pence) => `£${(pence / 100).toFixed(2)}`
