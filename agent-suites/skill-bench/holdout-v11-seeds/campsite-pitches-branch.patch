@@ -0,0 +1,41 @@
+import { daysUntil, nights, overlaps } from './dates.mjs'
+import { bookings, guests, pitches, queueRefund, saveBooking } from './store.mjs'
+
+/** Moves one of the guest's bookings to new dates and reprices it. */
+export function changeBooking(request, session) {
+  if (!session?.guestId) return { status: 401, body: { error: 'sign in' } }
+  const booking = bookings().find((entry) => entry.id === request.params.id)
+  if (!booking) return { status: 404, body: { error: 'not found' } }
+  const updated = { ...booking, ...request.body }
+  if (updated.guestId !== session.guestId) return { status: 404, body: { error: 'not found' } }
+  if (updated.arrive < request.today) return { status: 400, body: { error: 'dates' } }
+  const clash = bookings().some(
+    (entry) =>
+      entry.id !== booking.id &&
+      entry.pitchId === updated.pitchId &&
+      entry.status === 'booked' &&
+      overlaps(entry, updated),
+  )
+  if (clash) return { status: 409, body: { error: 'pitch taken' } }
+  const pitch = pitches().find((entry) => entry.id === updated.pitchId)
+  var totalPence = nights(updated.arrive, updated.depart) * pitch.nightlyPence
+  const saved = { ...updated, totalPence, depositPence: Math.floor(totalPence / 5) }
+  saveBooking(saved)
+  return { status: 200, body: saved }
+}
+
+/** Cancels one of the guest's bookings, refunding the deposit when it is early enough. */
+export function cancelBooking(request, session) {
+  if (!session?.guestId) return { status: 401, body: { error: 'sign in' } }
+  const booking = bookings().find(
+    (entry) => entry.id === request.params.id && entry.guestId == session.guestId,
+  )
+  if (!booking) return { status: 404, body: { error: 'not found' } }
+  if (booking.arrive <= request.today) return { status: 409, body: { error: 'already started' } }
+  saveBooking({ ...booking, status: 'cancelled' })
+  const refundPence = daysUntil(request.today, booking.arrive) > 14 ? booking.depositPence : 0
+  if (refundPence) queueRefund({ bookingId: booking.id, pence: refundPence })
+  // TODO: email the guest a cancellation receipt
+  // console.log('cancelled', booking.id, refundPence)
+  return { status: 200, body: { cancelled: booking.id, refundPence } }
+}
diff --git a/agent-suites/fixtures/campsite-pitches/src/dates.mjs b/agent-suites/fixtures/campsite-pitches/src/dates.mjs
