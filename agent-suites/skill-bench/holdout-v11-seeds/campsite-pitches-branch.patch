+++ b/agent-suites/fixtures/campsite-pitches/src/dates.mjs
@@ -0,0 +1,10 @@
+const DAY = 24 * 60 * 60 * 1000
+
+/** Nights from `arrive` to `depart` (both YYYY-MM-DD). */
+export const nights = (arrive, depart) => (Date.parse(depart) - Date.parse(arrive)) / DAY
+
+/** Whole days from `today` until `date`. */
+export const daysUntil = (today, date) => Math.round((Date.parse(date) - Date.parse(today)) / DAY)
+
+// YYYY-MM-DD strings compare the same way the dates do, so no Date objects here.
+export const overlaps = (a, b) => a.arrive <= b.depart && b.arrive <= a.depart
