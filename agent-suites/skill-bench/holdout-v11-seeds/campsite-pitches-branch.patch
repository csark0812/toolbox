@@ -0,0 +1,34 @@
+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { route } from '../src/api.mjs'
+import { refunds, reset } from '../src/store.mjs'
+
+beforeEach(reset)
+const priya = { guestId: 'g-1' }
+const tom = { guestId: 'g-2' }
+
+test('a guest can move their booking and it is repriced', () => {
+  const body = { arrive: '2027-05-27', depart: '2027-05-31' }
+  const response = route('PATCH', '/bookings/bk-1', { body }, priya)
+  assert.equal(response.status, 200)
+  assert.equal(response.body.totalPence, 12000)
+  assert.equal(response.body.depositPence, 2400)
+})
+
+test("another guest's booking cannot be changed", () => {
+  const body = { arrive: '2027-05-27', depart: '2027-05-30' }
+  assert.equal(route('PATCH', '/bookings/bk-1', { body }, tom).status, 404)
+})
+
+test('cancelling early refunds the deposit', () => {
+  const response = route('POST', '/bookings/bk-1/cancel', { today: '2027-05-01' }, priya)
+  assert.equal(response.status, 200)
+  assert.equal(response.body.refundPence, 1800)
+  assert.deepEqual(refunds(), [{ bookingId: 'bk-1', pence: 1800 }])
+})
+
+test('cancelling late refunds nothing', () => {
+  const response = route('POST', '/bookings/bk-1/cancel', { today: '2027-05-20' }, priya)
+  assert.equal(response.status, 200)
+  assert.equal(response.body.refundPence, 0)
+})
