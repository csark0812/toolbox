@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { withSiblingDiscount } from '../src/discounts.mjs'
+import { applyLateFees } from '../src/late-fees.mjs'
+import { invoices, reset } from '../src/store.mjs'
+
+beforeEach(reset)
+
+test('the dearest class is full price and the rest are 10% off', () => {
+  const lines = withSiblingDiscount([
+    { classId: 'street-jr', pence: 4800 },
+    { classId: 'ballet-g3', pence: 7200 },
+    { classId: 'tap-g2', pence: 5400 },
+  ])
+  assert.deepEqual(
+    lines.map((line) => line.pence),
+    [7200, 4860, 4320],
+  )
+})
+
+test('a single class is full price', () => {
+  assert.deepEqual(withSiblingDiscount([{ classId: 'ballet-g1', pence: 4800 }])[0].pence, 4800)
+})
+
+test('an unpaid invoice gets a late fee 14 days after it was due', () => {
+  assert.deepEqual(applyLateFees('2027-01-03'), [])
+  assert.deepEqual(applyLateFees('2027-01-04'), ['inv-2027-spring-f-1', 'inv-2027-spring-f-2'])
+  assert.equal(invoices().find((invoice) => invoice.id === 'inv-2027-spring-f-1').totalPence, 17900)
+})
