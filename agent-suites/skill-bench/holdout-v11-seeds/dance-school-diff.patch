+/** Sibling discount: the family's dearest class is full price, every further class is 10% off. */
+export function withSiblingDiscount(lines) {
+  const sorted = [...lines].sort((a, b) => b.pence - a.pence)
+  for (let i = 1; i < sorted.length; i++) {
+    sorted[i] = { ...sorted[i], pence: Math.floor((sorted[i].pence * 9) / 10), discounted: true }
+  }
+  return sorted
+}
