diff --git a/agent-suites/fixtures/dance-school/src/late-fees.mjs b/agent-suites/fixtures/dance-school/src/late-fees.mjs
new file mode 100644
index 0000000..fbb3c61
--- /dev/null
+++ b/agent-suites/fixtures/dance-school/src/late-fees.mjs
@@ -0,0 +1,18 @@
+import { invoices, setInvoices } from './store.mjs'
+import { addDays } from './terms.mjs'
+
+const LATE_FEE_PENCE = 500
+
+/** Adds the late fee to every invoice still unpaid 14 days after it was due. */
+export function applyLateFees(today) {
+  var charged = []
+  setInvoices(
+    invoices().map((invoice) => {
+      if (invoice.paidOn || today < addDays(invoice.dueOn, 14)) return invoice
+      charged.push(invoice.id)
+      return { ...invoice, totalPence: invoice.totalPence + LATE_FEE_PENCE, lateFee: true }
+    }),
+  )
+  // TODO: email the family
+  return charged
+}
