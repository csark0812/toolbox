@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { addOpenDays, dueDate } from '../src/due.mjs'
+
+test('a heel job dropped off on Tuesday is due on Thursday', () => {
+  assert.equal(dueDate({ job: 'heels', in: '2026-12-15' }), '2026-12-17')
+})
+
+test('a heel job dropped off on Friday is due on Tuesday, not over the weekend', () => {
+  assert.equal(dueDate({ job: 'heels', in: '2026-12-11' }), '2026-12-15')
+})
+
+test('a resole takes five open days', () => {
+  assert.equal(dueDate({ job: 'resole', in: '2026-12-15' }), '2026-12-22')
+})
+
+test('Sundays and Mondays are skipped', () => {
+  assert.equal(addOpenDays('2026-12-12', 1), '2026-12-15')
+})
