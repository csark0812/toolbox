+// How many open days each job takes, not counting the day the shoes come in. Resoles take
+// five because the soles come from the leather supplier on Thursdays.
+export const TURNAROUND = { heels: 2, stitching: 3, resole: 5 }
+
+const DAY = 86400000
+const nextDay = (date) => new Date(Date.parse(date) + DAY).toISOString().slice(0, 10)
+
+/** The shop is shut on Sundays and Mondays. */
+const isOpen = (date) => ![0, 1].includes(new Date(date).getUTCDay())
+
+/** The day that comes this many open days after another. */
+export function addOpenDays(from, days) {
+  let day = from
+  let left = days
+  while (left > 0) {
+    if (isOpen(day)) left--
+    day = nextDay(day)
+  }
+  return day
+}
+
+/** The day a job will be ready to collect. */
+export const dueDate = (job) => addOpenDays(job.in, TURNAROUND[job.job])
