@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { board } from '../src/outings.mjs'
+import { canBoat } from '../src/river.mjs'
+
+const single = { id: 'R1', start: '2026-11-07T07:00', boat: 'Heron', class: '1x', crew: ['Ana'] }
+const double = {
+  id: 'R3',
+  start: '2026-11-07T08:00',
+  boat: 'Swift',
+  class: '2x',
+  crew: ['Fay', 'Gus'],
+}
+const flags = (flag) => [{ date: '2026-11-07', flag }]
+
+test('a single stays ashore on an amber flag', () => {
+  assert.equal(canBoat(single, flags('amber')), false)
+})
+
+test('a double goes out on an amber flag', () => {
+  assert.equal(canBoat(double, flags('amber')), true)
+})
+
+test('nobody goes out on a red flag', () => {
+  assert.equal(canBoat(double, flags('red')), false)
+})
+
+test('boats kept in are marked on the board', () => {
+  assert.match(board([single], flags('red'))[0], /ashore$/)
+})
