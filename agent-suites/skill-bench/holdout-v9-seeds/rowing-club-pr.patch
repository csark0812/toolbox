@@ -0,0 +1,16 @@
+/** The river flag posted for an outing's day, if the river officer has posted one. */
+export function flagFor(outing, flags) {
+  const day = outing.start.split(' ')[0]
+  return flags.find((entry) => entry.date === day)?.flag
+}
+
+/**
+ * Whether an outing may go afloat under the club's river flags: on red nobody goes out,
+ * on amber singles (1x) stay ashore and every other boat may go, and green is open water.
+ */
+export function canBoat(outing, flags) {
+  const flag = flagFor(outing, flags)
+  if (flag === 'red') return false
+  if (flag === 'amber') return outing.class !== '1x'
+  return true
+}
diff --git a/agent-suites/fixtures/rowing-club/tests/river.test.mjs b/agent-suites/fixtures/rowing-club/tests/river.test.mjs
