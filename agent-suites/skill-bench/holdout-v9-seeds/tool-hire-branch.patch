+import assert from 'node:assert/strict'
+import { afterEach, beforeEach, test } from 'node:test'
+import { route } from '../src/api.mjs'
+import { refunds, reset, tools } from '../src/store.mjs'
+
+const realFetch = globalThis.fetch
+beforeEach(reset)
+afterEach(() => {
+  globalThis.fetch = realFetch
+})
+const counter = { staffId: 's-1' }
+const rhys = { customerId: 'c-1' }
+
+test('staff book a tool back in', async () => {
+  const response = await route(
+    'POST',
+    '/hires/h-201/return',
+    { body: { date: '2026-10-21' } },
+    counter,
+  )
+  assert.equal(response.status, 200)
+  assert.equal(response.body.status, 'returned')
+  assert.equal(response.body.chargePence, 7000)
+  assert.equal(tools().find((tool) => tool.id === 'tl-1').available, 3)
+  assert.deepEqual(refunds(), [{ hireId: 'h-201', pence: 5000 }])
+})
+
+test('customers cannot book a return', async () => {
+  const response = await route(
+    'POST',
+    '/hires/h-201/return',
+    { body: { date: '2026-10-21' } },
+    rhys,
+  )
+  assert.equal(response.status, 401)
+})
+
+test('a customer reports damage with a photo', async () => {
+  globalThis.fetch = async () =>
+    new Response(Buffer.from('fake jpeg'), { headers: { 'content-type': 'image/jpeg' } })
+  const body = { note: 'Chisel bit cracked', photoUrl: 'https://photos.example/crack.jpg' }
+  const response = await route('POST', '/hires/h-201/damage', { body }, rhys)
+  assert.equal(response.status, 201)
+  const hire = await route('GET', '/hires/h-201', {}, rhys)
+  assert.equal(hire.body.damage.photo.type, 'image/jpeg')
+  assert.equal(hire.body.damage.note, 'Chisel bit cracked')
+})
