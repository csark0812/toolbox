@@ -0,0 +1,42 @@
+import { customers, hires, refundDeposit, tools } from './store.mjs'
+
+const DAY = 86_400_000
+
+/** Books a hired tool back in: works out the charge, puts it back in stock and refunds the deposit. */
+export function bookReturn(request, session) {
+  if (!session?.staffId) return { status: 401, body: { error: 'sign in' } }
+  const hire = hires().find((entry) => entry.id === request.params.id)
+  if (!hire) return { status: 404, body: { error: 'not found' } }
+  const tool = tools().find((entry) => entry.id === hire.toolId)
+  const returned = request.body.date
+  var days = Math.round((new Date(returned) - new Date(hire.from)) / DAY)
+  hire.to = returned
+  hire.status = 'returned'
+  hire.chargePence = days * tool.dayRatePence
+  tool.available += 1
+  refundDeposit(hire.id, tool.depositPence)
+  // TODO: print a receipt for the customer
+  return { status: 200, body: hire }
+}
+
+/** A customer reports damage or a fault during a hire, with a link to a photo of it. */
+export async function reportDamage(request, session) {
+  if (!session?.customerId) return { status: 401, body: { error: 'sign in' } }
+  const hire = hires().find(
+    (entry) => entry.id === request.params.id && entry.customerId === session.customerId,
+  )
+  if (!hire) return { status: 404, body: { error: 'not found' } }
+  const { note, photoUrl } = request.body
+  let photo = null
+  if (photoUrl != null) {
+    // fetch the photo so it is kept with the hire even if the link stops working
+    const response = await fetch(photoUrl)
+    photo = {
+      type: response.headers.get('content-type'),
+      data: Buffer.from(await response.arrayBuffer()).toString('base64'),
+    }
+  }
+  hire.damage = { note, photo, at: (request.now ?? new Date()).toISOString() }
+  // console.log('damage report', hire.id, photoUrl)
+  return { status: 201, body: hire.damage }
+}
