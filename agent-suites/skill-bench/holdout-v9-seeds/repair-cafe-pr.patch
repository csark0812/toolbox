+++ b/agent-suites/fixtures/repair-cafe/tests/safety.test.mjs
@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { awaitingPat, needsPatTest } from '../src/safety.mjs'
+
+const toaster = {
+  ticket: 4,
+  item: 'toaster',
+  category: 'electrical',
+  outcome: 'fixed',
+  mains: true,
+}
+const coat = { ticket: 5, item: 'coat', category: 'textile', outcome: 'fixed' }
+const radio = { ticket: 6, item: 'radio', category: 'electrical', outcome: 'fixed', mains: false }
+
+test('a mended toaster needs a PAT test', () => {
+  assert.equal(needsPatTest(toaster), true)
+})
+
+test('a mended coat needs no PAT test', () => {
+  assert.equal(needsPatTest(coat), false)
+})
+
+test('a battery radio needs no PAT test', () => {
+  assert.equal(needsPatTest(radio), false)
+})
+
+test('items already tested are not waiting', () => {
+  assert.deepEqual(awaitingPat([{ ...toaster, patTested: true }, toaster]), [toaster])
+})
