@@ -0,0 +1,33 @@
+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { route } from '../src/api.mjs'
+import { reset } from '../src/store.mjs'
+
+beforeEach(reset)
+const margaret = { landlordId: 'll-1' }
+const claim = (body, now) =>
+  route('POST', '/tenancies/t-1/deductions', { body, now: new Date(now) }, margaret)
+
+test('a landlord claims a deduction after the tenancy ends', () => {
+  const response = claim({ amount: '85.50', reason: 'Carpet cleaning' }, '2026-10-12T10:00Z')
+  assert.equal(response.status, 201)
+  assert.equal(response.body.pence, 8550)
+})
+
+test('claims close after the claim window', () => {
+  const response = claim({ amount: '20', reason: 'Bulb' }, '2026-10-25T10:00Z')
+  assert.equal(response.status, 409)
+})
+
+test('a claim cannot be more than the deposit', () => {
+  const response = claim({ amount: '1500', reason: 'Redecorating' }, '2026-10-12T10:00Z')
+  assert.equal(response.status, 422)
+})
+
+test('the tenant sees the claims and what comes back', () => {
+  claim({ amount: '85.50', reason: 'Carpet cleaning' }, '2026-10-12T10:00Z')
+  const response = route('GET', '/portal/deposit', {}, { tenancyId: 't-1' })
+  assert.equal(response.status, 200)
+  assert.match(response.body, /Carpet cleaning: £85\.50/)
+  assert.match(response.body, /Returned to you: £1,114\.50/)
+})
