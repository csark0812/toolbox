--- /dev/null
+++ b/agent-suites/fixtures/lettings/src/deductions.mjs
@@ -0,0 +1,50 @@
+import { page, pounds } from './html.mjs'
+import { addDeduction, deductions, landlords, tenancies } from './store.mjs'
+
+const DAY = 86_400_000
+const CLAIM_DAYS = 10
+
+/** Claims a deduction from a tenancy's deposit, e.g. { amount: '85.50', reason: 'Carpet clean' }. */
+export function claimDeduction(request, session) {
+  if (!session?.landlordId) return { status: 401, body: { error: 'sign in' } }
+  const tenancy = tenancies().find((entry) => entry.id === request.params.id)
+  if (!tenancy) return { status: 404, body: { error: 'not found' } }
+  const now = request.now ?? new Date()
+  const daysAfterEnd = Math.floor((now - new Date(`${tenancy.end}T00:00:00Z`)) / DAY)
+  if (daysAfterEnd >= CLAIM_DAYS) {
+    return { status: 409, body: { error: 'the claim window has closed' } }
+  }
+  let pence = Math.round(Number(request.body.amount) * 100)
+  if (!(pence > 0)) return { status: 400, body: { error: 'amount must be more than £0' } }
+  if (pence > tenancy.depositPence) {
+    return { status: 422, body: { error: 'that is more than the deposit' } }
+  }
+  // TODO: email the tenant when a deduction is claimed
+  const row = addDeduction({
+    tenancyId: tenancy.id,
+    pence,
+    reason: request.body.reason,
+    at: now.toISOString().slice(0, 10),
+  })
+  return { status: 201, body: row }
+}
+
+/** The tenant portal's deposit statement: what has been claimed and what comes back. */
+export function depositStatement(request, session) {
+  if (!session?.tenancyId) return { status: 401, body: { error: 'sign in' } }
+  const tenancy = tenancies().find((entry) => entry.id === session.tenancyId)
+  if (!tenancy) return { status: 404, body: { error: 'not found' } }
+  const claimed = deductions().filter((deduction) => deduction.tenancyId == tenancy.id)
+  const total = claimed.reduce((sum, deduction) => sum + deduction.pence, 0)
+  const items = claimed.map(
+    (deduction) => `<li>${deduction.reason}: ${pounds(deduction.pence)}</li>`,
+  )
+  const body = [
+    '<h1>Deposit statement</h1>',
+    `<ul>${items.join('')}</ul>`,
+    `<p>Deductions: ${pounds(total)}</p>`,
+    `<p>Returned to you: ${pounds(tenancy.depositPence - total)}</p>`,
+  ].join('\n')
+  // console.log('statement', tenancy.id, total)
+  return { status: 200, body: page('Deposit statement', body) }
+}
