index 0000000..4401980
--- /dev/null
+++ b/agent-suites/fixtures/farm-shop/src/boxes.mjs
@@ -0,0 +1,20 @@
+import { orderTotal } from './orders.mjs'
+
+/** Products that are never discounted: they come from other farms. */
+const FULL_PRICE = new Set(['eggs', 'honey'])
+
+/** The veg in an order, in pence: everything except the full-price products. */
+export const vegTotal = (order, prices) =>
+  order.items
+    .filter((item) => !FULL_PRICE.has(item.product))
+    .reduce((sum, item) => sum + prices[item.product] * item.qty, 0)
+
+/** A subscriber's box discount in pence: 10% off the veg when the veg comes to £20 or more. */
+export function boxDiscount(order, prices) {
+  if (!order.subscriber) return 0
+  const veg = vegTotal(order, prices)
+  return veg > 2000 ? Math.round(veg / 10) : 0
+}
+
+/** What the customer pays at the till, in pence. */
+export const amountDue = (order, prices) => orderTotal(order, prices) - boxDiscount(order, prices)
