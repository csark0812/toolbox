@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { boxDiscount } from '../src/boxes.mjs'
+
+const prices = { kale: 200, squash: 250, eggs: 180 }
+const order = (subscriber, items) => ({ id: 'T', customer: 'Test', subscriber, items })
+
+test('a subscriber with exactly £20 of veg gets 10% off', () => {
+  assert.equal(boxDiscount(order(true, [{ product: 'kale', qty: 10 }]), prices), 200)
+})
+
+test('a subscriber with £25 of veg gets £2.50 off', () => {
+  assert.equal(boxDiscount(order(true, [{ product: 'squash', qty: 10 }]), prices), 250)
+})
+
+test('eggs do not count towards the £20', () => {
+  const items = [
+    { product: 'kale', qty: 9 },
+    { product: 'eggs', qty: 2 },
+  ]
+  assert.equal(boxDiscount(order(true, items), prices), 0)
+})
