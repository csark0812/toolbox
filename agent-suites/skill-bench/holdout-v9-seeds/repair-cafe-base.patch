@@ -1,12 +1,21 @@
 /** How many of the repairs had this outcome. */
 const count = (repairs, outcome) => repairs.filter((repair) => repair.outcome === outcome).length
 
-/** Lines of the end-of-session report. */
+const OUTCOMES = [
+  ['fixed', 'Fixed'],
+  ['advice', 'Advice given'],
+  ['unfixable', 'Not fixable'],
+]
+const CATEGORIES = ['electrical', 'textile', 'bike', 'furniture']
+
+/** Lines of the end-of-session report: the outcomes, then each category. */
 export function report(repairs) {
   return [
     `Items seen: ${repairs.length}`,
-    `Fixed: ${count(repairs, 'fixed')}`,
-    `Advice given: ${count(repairs, 'advice')}`,
-    `Not fixable: ${count(repairs, 'unfixable')}`,
+    ...OUTCOMES.map(([outcome, label]) => `${label}: ${count(repairs, outcome)}`),
+    ...CATEGORIES.map((category) => {
+      const items = repairs.filter((repair) => repair.category === category)
+      return `  ${category}: ${items.length} seen, ${count(items, 'fixed')} fixed`
+    }),
   ]
 }
