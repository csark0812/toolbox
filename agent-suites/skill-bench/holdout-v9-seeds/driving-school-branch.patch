@@ -0,0 +1,27 @@
+import { learners, lessons, saveLesson } from './store.mjs'
+
+export const LATE_FEE_PENCE = 1500
+
+/** Moves one of the learner's lessons to a new start time, adding the late-change fee inside 48 hours. */
+export function rescheduleLesson(request, session) {
+  if (!session?.learnerId) return { status: 401, body: { error: 'sign in' } }
+  const lesson = lessons().find(
+    (entry) => entry.id === request.params.id && entry.learnerId === session.learnerId,
+  )
+  if (!lesson) return { status: 404, body: { error: 'not found' } }
+  const now = request.now ?? new Date()
+  const start = new Date(`${lesson.start}Z`)
+  // hours of notice the learner is giving
+  const notice =
+    (start.getUTCDate() - now.getUTCDate()) * 24 + (start.getUTCHours() - now.getUTCHours())
+  var late = notice < 48
+  // TODO: email the instructor when a lesson moves
+  const moved = {
+    ...lesson,
+    start: request.body.start,
+    feePence: (lesson.feePence ?? 0) + (late ? LATE_FEE_PENCE : 0),
+  }
+  saveLesson(moved)
+  // console.log('rescheduled', moved.id, moved.start)
+  return { status: 200, body: moved }
+}
