+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { route } from '../src/api.mjs'
+import { reset } from '../src/store.mjs'
+
+beforeEach(reset)
+const maya = { learnerId: 'l-1' }
+
+test('moving a lesson a week ahead is free', () => {
+  const request = {
+    body: { start: '2026-10-28T15:00' },
+    now: new Date('2026-10-21T09:00Z'),
+  }
+  const response = route('POST', '/lessons/ls-101/move', request, maya)
+  assert.equal(response.status, 200)
+  assert.equal(response.body.start, '2026-10-28T15:00')
+  assert.equal(response.body.feePence, 0)
+})
+
+test('moving a lesson the day before costs the late fee', () => {
+  const request = {
+    body: { start: '2026-11-02T15:00' },
+    now: new Date('2026-11-01T12:00Z'),
+  }
+  const response = route('POST', '/lessons/ls-103/move', request, maya)
+  assert.equal(response.status, 200)
+  assert.equal(response.body.feePence, 1500)
+})
+
+test("a learner cannot move someone else's lesson", () => {
+  const request = { body: { start: '2026-10-28T15:00' }, now: new Date('2026-10-21T09:00Z') }
+  assert.equal(route('POST', '/lessons/ls-102/move', request, maya).status, 404)
+})
