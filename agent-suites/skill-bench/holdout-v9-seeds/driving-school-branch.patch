@@ -0,0 +1,41 @@
+import { instructors, learners, lessons } from './store.mjs'
+
+/** The secret part of an instructor's calendar subscription link. */
+export function feedToken(instructorId) {
+  return Buffer.from(`feed:${instructorId}`).toString('base64url')
+}
+
+const stamp = (start) => `${start.replace(/[-:]/g, '')}00Z`
+
+/**
+ * An instructor's diary as an iCalendar feed for their phone. Calendar apps can't sign in,
+ * so the token in the link is what identifies the instructor.
+ */
+export function instructorFeed(request) {
+  const id = Buffer.from(request.params.token, 'base64url').toString('utf8').replace('feed:', '')
+  const instructor = instructors().find((entry) => entry.id == id)
+  if (!instructor) return { status: 404, body: { error: 'not found' } }
+  const events = lessons()
+    .filter((lesson) => lesson.instructorId === instructor.id)
+    .map((lesson) => {
+      const learner = learners().find((entry) => entry.id === lesson.learnerId)
+      return [
+        'BEGIN:VEVENT',
+        `UID:${lesson.id}@northgate-driving`,
+        `DTSTART:${stamp(lesson.start)}`,
+        `DURATION:PT${lesson.minutes}M`,
+        `SUMMARY:Lesson with ${learner.name}`,
+        `LOCATION:${learner.pickup}`,
+        `DESCRIPTION:Phone ${learner.phone}`,
+        'END:VEVENT',
+      ].join('\r\n')
+    })
+  const calendar = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Northgate//Diary//EN']
+  return { status: 200, body: [...calendar, ...events, 'END:VCALENDAR'].join('\r\n') }
+}
+
+/** The signed-in instructor's calendar subscription link. */
+export function feedLink(request, session) {
+  if (!session?.instructorId) return { status: 401, body: { error: 'sign in' } }
+  return { status: 200, body: { url: `/feed/${feedToken(session.instructorId)}` } }
+}
