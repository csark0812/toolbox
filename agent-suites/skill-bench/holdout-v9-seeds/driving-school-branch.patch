+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { route } from '../src/api.mjs'
+
+test("an instructor's feed link shows their diary", () => {
+  const link = route('GET', '/feed-link', {}, { instructorId: 'i-1' })
+  assert.equal(link.status, 200)
+  const feed = route('GET', link.body.url)
+  assert.equal(feed.status, 200)
+  assert.match(feed.body, /SUMMARY:Lesson with Maya Brooks/)
+})
+
+test('the feed link needs an instructor session', () => {
+  assert.equal(route('GET', '/feed-link', {}, { learnerId: 'l-1' }).status, 401)
+})
