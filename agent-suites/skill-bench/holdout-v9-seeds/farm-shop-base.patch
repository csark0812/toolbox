@@ -0,0 +1,10 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { priceOf, unitOf } from '../src/prices.mjs'
+
+const prices = { leeks: { pence: 150, per: 'bunch' } }
+
+test('a price carries the unit it is sold by', () => {
+  assert.equal(priceOf(prices, 'leeks'), 150)
+  assert.equal(unitOf(prices, 'leeks'), 'bunch')
+})
