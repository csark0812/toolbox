 const byText = (a, b) => (a < b ? -1 : a > b ? 1 : 0)
 
+/** The strength band shown next to each beer: session, standard or strong. */
+export function band(abv) {
+  if (abv < 4) return 'session'
+  if (abv > 5.5) return 'strong'
+  return 'standard'
+}
+
 /** Lines of the list pinned up behind the bars. */
 export function barList(casks) {
   return [...casks]
     .sort((a, b) => byText(a.beer, b.beer))
