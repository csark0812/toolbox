@@ -0,0 +1,18 @@
+#!/usr/bin/env node
+import { readFileSync } from 'node:fs'
+import { stdout } from 'node:process'
+import { reorderSheet } from '../src/reorder.mjs'
+import { money, readStock } from '../src/stock.mjs'
+
+const read = (name) => readFileSync(new URL(`../data/${name}`, import.meta.url), 'utf8')
+const sheet = reorderSheet(readStock(read('stock.csv')), JSON.parse(read('deliveries.json')))
+if (sheet.size == 0) stdout.write('Nothing to reorder.\n')
+for (const [supplier, orders] of sheet) {
+  stdout.write(`${supplier}\n`)
+  for (const order of orders)
+    stdout.write(
+      `  ${order.sku.padEnd(8)}${order.plant.padEnd(26)}${String(order.trays).padStart(2)} trays  ${money(order.pence).padStart(8)}\n`,
+    )
+  const total = orders.reduce((sum, order) => sum + order.pence, 0)
+  stdout.write(`  ${'Total'.padEnd(42)}${money(total).padStart(8)}\n`)
+}
