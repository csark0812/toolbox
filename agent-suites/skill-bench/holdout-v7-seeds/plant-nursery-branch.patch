+/** Plants already on their way for a SKU. */
+export function pendingFor(deliveries, sku) {
+  return deliveries
+    .filter((delivery) => delivery.sku.startsWith(sku))
+    .reduce((sum, delivery) => sum + delivery.plants, 0)
+}
diff --git a/agent-suites/fixtures/plant-nursery/src/reorder.mjs b/agent-suites/fixtures/plant-nursery/src/reorder.mjs
