@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { reorderSheet } from '../src/reorder.mjs'
+
+const line = (overrides) => ({
+  sku: 'LAV-3',
+  plant: 'Lavender',
+  supplier: 'Greenleaf',
+  stock: 6,
+  reorderLevel: 10,
+  target: 30,
+  traySize: 12,
+  trayPence: 2880,
+  discontinued: false,
+  ...overrides,
+})
+
+test('a low line is reordered back to target', () => {
+  const sheet = reorderSheet([line()], [])
+  assert.deepEqual(sheet.get('Greenleaf'), [
+    { sku: 'LAV-3', plant: 'Lavender', trays: 2, plants: 24, pence: 5760 },
+  ])
+})
+
+test('a line above its reorder level is left alone', () => {
+  assert.equal(reorderSheet([line({ stock: 11 })], []).size, 0)
+})
+
+test('a pending delivery counts as stock', () => {
+  assert.equal(reorderSheet([line()], [{ sku: 'LAV-3', plants: 12, due: '2026-10-20' }]).size, 0)
+})
