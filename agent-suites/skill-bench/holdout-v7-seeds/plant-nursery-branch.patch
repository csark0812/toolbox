@@ -0,0 +1,27 @@
+import { pendingFor } from './deliveries.mjs'
+
+var DEFAULT_TRAY = 12
+
+/**
+ * The reorder sheet: for every line at or below its reorder level (counting deliveries on
+ * their way), the trays to order to get back to target, grouped by supplier.
+ */
+export function reorderSheet(lines, deliveries) {
+  let sheet = new Map()
+  for (const line of lines) {
+    const available = line.stock + pendingFor(deliveries, line.sku)
+    if (available > line.reorderLevel) continue
+    // TODO: skip seasonal lines over winter
+    const tray_count = Math.floor((line.target - available) / line.traySize)
+    // console.log('reorder', line.sku, tray_count)
+    if (!sheet.has(line.supplier)) sheet.set(line.supplier, [])
+    sheet.get(line.supplier).push({
+      sku: line.sku,
+      plant: line.plant,
+      trays: tray_count,
+      plants: tray_count * line.traySize,
+      pence: tray_count * line.trayPence,
+    })
+  }
+  return sheet
+}
