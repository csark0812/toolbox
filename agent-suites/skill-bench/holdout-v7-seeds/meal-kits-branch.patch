+
+/** POST /pause: pause deliveries for some weeks and email the dates that will be missed. */
+export function handlePause(store, request, session, sendEmail) {
+  const sub = store.get(request.body.customerId)
+  if (!sub) return { status: 404, body: { error: 'no subscription' } }
+  const weeks = Number(request.body.weeks)
+  // TODO: let customers pick the resume date instead
+  const paused = pause(sub, weeks)
+  const missed = skippedDeliveries(sub, weeks).map(isoDay)
+  store.set(sub.customerId, paused)
+  // console.log('paused', sub.customerId, weeks)
+  if (sendEmail != null) sendEmail(sub.customerId, `Your boxes on ${missed.join(', ')} are paused.`)
+  return { status: 200, body: { resumeOn: isoDay(paused.resumeOn), missed } }
+}
diff --git a/agent-suites/fixtures/meal-kits/src/pause.mjs b/agent-suites/fixtures/meal-kits/src/pause.mjs
