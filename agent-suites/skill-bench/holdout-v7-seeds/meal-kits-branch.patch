@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { handlePause } from '../src/api.mjs'
+import { pause, skippedDeliveries } from '../src/pause.mjs'
+import { isoDay, loadStore } from '../src/store.mjs'
+
+const sub = () => ({ customerId: 'c-1', nextDelivery: new Date('2026-10-22T00:00:00Z') })
+
+test('a pause resumes on the same weekday', () => {
+  assert.equal(isoDay(pause(sub(), 3).resumeOn), '2026-11-12')
+})
+
+test('the skipped deliveries are listed', () => {
+  assert.deepEqual(skippedDeliveries(sub(), 2).map(isoDay), ['2026-10-22', '2026-10-29'])
+})
+
+test('pausing through the handler', () => {
+  const emails = []
+  const response = handlePause(
+    loadStore(),
+    { body: { customerId: 'c-103', weeks: 2 } },
+    { customerId: 'c-103' },
+    (to, text) => emails.push([to, text]),
+  )
+  assert.equal(response.status, 200)
+  assert.equal(response.body.resumeOn, '2026-11-06')
+  assert.equal(emails.length, 1)
+})
