--- /dev/null
+++ b/agent-suites/fixtures/meal-kits/src/pause.mjs
@@ -0,0 +1,15 @@
+import { weeksAfter } from './store.mjs'
+
+/** The subscription paused for `weeks`, resuming on the same weekday. */
+export function pause(sub, weeks) {
+  const resume_on = sub.nextDelivery
+  resume_on.setUTCDate(resume_on.getUTCDate() + weeks * 7)
+  return { ...sub, paused: true, resumeOn: resume_on }
+}
+
+/** The delivery dates a pause of `weeks` skips, starting with the next one. */
+export function skippedDeliveries(sub, weeks) {
+  var dates = []
+  for (let i = 0; i < weeks; i++) dates.push(weeksAfter(sub.nextDelivery, i))
+  return dates
+}
