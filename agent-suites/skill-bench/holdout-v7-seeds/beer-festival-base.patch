+++ b/agent-suites/fixtures/beer-festival/src/casks.mjs
@@ -1,10 +1,16 @@
 const byText = (a, b) => (a < b ? -1 : a > b ? 1 : 0)
 
-/** Lines of the list pinned up behind the bars. */
+/** Lines of the list pinned up behind the bars: each bar's beers under its name. */
 export function barList(casks) {
-  return [...casks]
-    .sort((a, b) => byText(a.beer, b.beer))
-    .map((cask) => `${cask.beer.padEnd(22)}${cask.brewery.padEnd(18)}${cask.abv.toFixed(1)}%`)
+  const lines = []
+  for (const bar of [...new Set(casks.map((cask) => cask.bar))].sort(byText)) {
+    lines.push(`${bar} bar`)
+    for (const cask of casks
+      .filter((entry) => entry.bar === bar)
+      .sort((a, b) => byText(a.beer, b.beer)))
+      lines.push(`  ${cask.beer.padEnd(22)}${cask.brewery.padEnd(18)}${cask.abv.toFixed(1)}%`)
+  }
+  return lines
 }
 
 /** One programme line per beer, by brewery. */
