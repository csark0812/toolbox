--- /dev/null
+++ b/agent-suites/fixtures/parcel-lockers/tests/returns.test.mjs
@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { overdue } from '../src/returns.mjs'
+
+const parcel = (locker, deliveredAt, collectedAt = null) => ({
+  id: locker,
+  locker,
+  site: 'x',
+  recipient: 'y',
+  deliveredAt,
+  collectedAt,
+})
+const ids = (list) => list.map((p) => p.locker)
+
+test('a parcel in for 73 hours goes back', () => {
+  assert.deepEqual(ids(overdue([parcel('A1', '2026-10-12T09:00:00Z')], '2026-10-15T10:00:00Z')), [
+    'A1',
+  ])
+})
+
+test('a parcel in for 71 hours stays', () => {
+  assert.deepEqual(ids(overdue([parcel('A1', '2026-10-12T09:00:00Z')], '2026-10-15T08:00:00Z')), [])
+})
+
+test('exactly 72 hours stays one more round', () => {
+  assert.deepEqual(ids(overdue([parcel('A1', '2026-10-12T09:00:00Z')], '2026-10-15T09:00:00Z')), [])
+})
