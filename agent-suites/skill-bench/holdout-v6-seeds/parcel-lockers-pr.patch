@@ -0,0 +1,7 @@
+/** Parcels the courier takes back: in their locker for more than 72 hours. */
+export function overdue(parcels, at) {
+  const now = Date.parse(at)
+  return parcels
+    .filter((p) => (now - Date.parse(p.deliveredAt)) / 3600 > 72)
+    .sort((a, b) => a.locker.localeCompare(b.locker))
+}
diff --git a/agent-suites/fixtures/parcel-lockers/tests/returns.test.mjs b/agent-suites/fixtures/parcel-lockers/tests/returns.test.mjs
