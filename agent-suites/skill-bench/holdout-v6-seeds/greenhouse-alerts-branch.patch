+#!/usr/bin/env node
+import { readFileSync } from 'node:fs'
+import { argv, exit, stderr, stdout } from 'node:process'
+import { frostAlerts } from '../src/frost.mjs'
+import { sendAll } from '../src/notify.mjs'
+import { sendSms } from '../src/sms.mjs'
+
+const date = argv[2]
+if (!/^\d{4}-\d{2}-\d{2}$/.test(date ?? '')) {
+  stderr.write('usage: alerts <YYYY-MM-DD>\n')
+  exit(2)
+}
+const readings = JSON.parse(readFileSync(new URL('../data/readings.json', import.meta.url), 'utf8'))
+const alerts = frostAlerts(readings, date)
+await sendAll(alerts, sendSms)
+stdout.write(`${alerts.length} frost alert(s) sent\n`)
+exit(0)
