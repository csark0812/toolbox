@@ -0,0 +1,9 @@
+/** Texts every alert to the night grower; resolves once they have all been sent. */
+export async function sendAll(alerts, send) {
+  alerts.forEach(async (alert) => {
+    await send(
+      `Frost risk in house ${alert.house}: ${alert.value} °C at ${alert.at.slice(11, 16)} UTC`,
+    )
+  })
+  // console.log('queued', alerts)
+}
