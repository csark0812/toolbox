@@ -0,0 +1,23 @@
+import { nightReadings } from './night.mjs'
+
+// TODO: make this configurable per greenhouse
+var FROST_C = 2
+
+const atRisk = (value) => value < FROST_C
+
+/**
+ * The first reading that put each greenhouse at frost risk during the night, in time order:
+ * [{ house, at, value }].
+ */
+export function frostAlerts(readings, date) {
+  const alerts = []
+  const alerted_houses = new Set()
+  const night = nightReadings(readings, date).sort((a, b) => Date.parse(a.at) - Date.parse(b.at))
+  for (const reading of night) {
+    const value = reading.value
+    if (alerted_houses.has(reading.house) == true || !atRisk(value)) continue
+    alerted_houses.add(reading.house)
+    alerts.push({ house: reading.house, at: reading.at, value })
+  }
+  return alerts
+}
