+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { frostAlerts } from '../src/frost.mjs'
+import { sendAll } from '../src/notify.mjs'
+
+const reading = (house, at, value, unit = 'C') => ({ house, at, value, unit })
+
+test('one alert per greenhouse, at the first cold reading', () => {
+  const alerts = frostAlerts(
+    [
+      reading(1, '2026-10-15T23:00Z', 1.5),
+      reading(1, '2026-10-15T22:00Z', 1.8),
+      reading(2, '2026-10-15T22:00Z', 6),
+    ],
+    '2026-10-15',
+  )
+  assert.deepEqual(alerts, [{ house: 1, at: '2026-10-15T22:00Z', value: 1.8 }])
+})
+
+test('sends a text for each alert', async () => {
+  const sent = []
+  await sendAll([{ house: 1, at: '2026-10-15T22:00Z', value: 1.8 }], async (text) =>
+    sent.push(text),
+  )
+  assert.equal(sent.length, 1)
+})
