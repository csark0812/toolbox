+#!/usr/bin/env node
+import { readFileSync } from 'node:fs'
+import { stdout } from 'node:process'
+import { costPerPortion, pounds } from '../src/costing.mjs'
+
+const read = (name) => JSON.parse(readFileSync(new URL(`../data/${name}`, import.meta.url), 'utf8'))
+const prices = read('prices.json')
+for (const recipe of read('recipes.json'))
+  stdout.write(
+    `${recipe.name.padEnd(22)} ${pounds(costPerPortion(recipe, prices)).padStart(6)} a portion\n`,
+  )
