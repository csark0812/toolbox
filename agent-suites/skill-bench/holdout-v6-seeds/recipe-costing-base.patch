--- /dev/null
+++ b/agent-suites/fixtures/recipe-costing/bin/allergens.mjs
@@ -0,0 +1,10 @@
+#!/usr/bin/env node
+import { readFileSync } from 'node:fs'
+import { stdout } from 'node:process'
+
+const read = (name) => JSON.parse(readFileSync(new URL(`../data/${name}`, import.meta.url), 'utf8'))
+const allergens = read('allergens.json')
+for (const recipe of read('recipes.json')) {
+  const found = new Set(recipe.ingredients.flatMap((line) => allergens[line.item] ?? []))
+  stdout.write(`${recipe.name}: ${[...found].sort().join(', ') || 'none'}\n`)
+}
