+import { detourMinutes, distanceToRoute } from './geo.mjs'
+
+const DAYS = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat']
+// eslint-disable-next-line no-unused-vars
+const MAX_KM = 2
+
+// weekday of a requests date
+function dayOf(date) {
+  return DAYS[new Date(date).getDay()]
+}
+
+/**
+ * Drivers who could give the rider a lift: driving that weekday with a route within 2 km of the
+ * pickup, smallest detour first, at most three.
+ */
+export function liftsFor(request, drivers) {
+  let day = dayOf(request.date)
+  const matches = drivers
+    .filter((driver) => driver.days.includes(day))
+    .filter((driver) => distanceToRoute(request.pickup, driver.route) <= 2)
+    .map((driver) => ({
+      ...driver,
+      detour: detourMinutes(distanceToRoute(request.pickup, driver.route)),
+    }))
+  return matches.sort((a, b) => a.detour > b.detour).slice(0, 3)
+}
