+#!/usr/bin/env node
+import { readFileSync } from 'node:fs'
+import { argv, exit, stderr, stdout } from 'node:process'
+import { liftsFor } from '../src/match.mjs'
+
+const read = (name) => JSON.parse(readFileSync(new URL(`../data/${name}`, import.meta.url), 'utf8'))
+const request = read('requests.json').find((r) => r.id === argv[2])
+if (!request) {
+  stderr.write('usage: match <request id>\n')
+  exit(2)
+}
+const found = liftsFor(request, read('drivers.json'))
+stdout.write(`Lifts for ${request.rider} on ${request.date}:\n`)
+for (const driver of found)
+  stdout.write(
+    `  ${driver.name.padEnd(14)} ${String(driver.detour).padStart(2)} min detour  ${driver.phone}, ${driver.home}\n`,
+  )
+if (!found.length) stdout.write('  nobody is driving your way that day\n')
