@@ -0,0 +1,50 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { liftsFor } from '../src/match.mjs'
+
+const driver = (id, days, route) => ({ id, name: id, phone: '', home: '', days, route })
+
+test('drivers that day near the pickup, smallest detour first', () => {
+  const drivers = [
+    driver(
+      'near',
+      ['tue', 'wed'],
+      [
+        [0, 0.5],
+        [10, 0.5],
+      ],
+    ),
+    driver(
+      'far',
+      ['tue', 'wed'],
+      [
+        [0, 1.5],
+        [10, 1.5],
+      ],
+    ),
+    driver(
+      'offday',
+      ['fri'],
+      [
+        [0, 0],
+        [10, 0],
+      ],
+    ),
+    driver(
+      'away',
+      ['tue', 'wed'],
+      [
+        [0, 9],
+        [10, 9],
+      ],
+    ),
+  ]
+  const found = liftsFor({ pickup: [5, 0], date: '2026-10-21' }, drivers)
+  assert.deepEqual(
+    found.map((d) => [d.id, d.detour]),
+    [
+      ['near', 2],
+      ['far', 6],
+    ],
+  )
+})
