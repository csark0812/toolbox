+++ b/agent-suites/fixtures/book-club/tests/votes.test.mjs
@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { tally, winner } from '../src/votes.mjs'
+
+const list = [
+  { title: 'A', nominatedAt: '2026-10-01T00:00:00Z' },
+  { title: 'B', nominatedAt: '2026-10-02T00:00:00Z' },
+]
+
+test('one vote per member', () => {
+  assert.deepEqual(
+    tally([
+      { member: 'Ana', title: 'A' },
+      { member: 'Ana', title: 'B' },
+      { member: 'Dev', title: 'B' },
+    ]),
+    { A: 1, B: 1 },
+  )
+})
+
+test('most votes wins', () => {
+  assert.equal(winner({ A: 1, B: 3 }, list).title, 'B')
+})
+
+test('a tie goes to the earlier nomination', () => {
+  assert.equal(winner({ A: 2, B: 2 }, list).title, 'A')
+})
