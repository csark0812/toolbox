+#!/usr/bin/env node
+import { readFileSync } from 'node:fs'
+import { stdout } from 'node:process'
+import { tally, winner } from '../src/votes.mjs'
+
+const votes = JSON.parse(readFileSync(new URL('../data/votes.json', import.meta.url), 'utf8'))
+const counted = tally(votes)
+for (const [title, count] of Object.entries(counted))
+  stdout.write(`${String(count).padStart(3)}  ${title}\n`)
+stdout.write(`Next month: ${winner(counted).title}\n`)
