+#!/usr/bin/env node
+import { readFileSync } from 'node:fs'
+import { stdout } from 'node:process'
+import { nominations } from '../src/members.mjs'
+import { tally, winner } from '../src/votes.mjs'
+
+// Prints the results page for the club's website.
+const votes = JSON.parse(readFileSync(new URL('../data/votes.json', import.meta.url), 'utf8'))
+const counted = tally(votes)
+const items = nominations()
+  .map(
+    (n) =>
+      `    <li><strong>${n.title}</strong> (${counted[n.title] ?? 0} votes)<br />${n.by}: ${n.note}</li>`,
+  )
+  .join('\n')
+stdout.write(`<section class="results">
+  <h2>This month's vote</h2>
+  <ul>
+${items}
+  </ul>
+  <p>Next month we read <strong>${winner(counted).title}</strong>.</p>
+</section>
+`)
