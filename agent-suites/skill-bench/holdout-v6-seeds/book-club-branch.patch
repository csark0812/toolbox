index 0000000..a1dff84
--- /dev/null
+++ b/agent-suites/fixtures/book-club/src/votes.mjs
@@ -0,0 +1,20 @@
+import { nominations } from './members.mjs'
+
+/** Votes per title; each member's first vote counts. */
+export function tally(votes) {
+  var counted = {}
+  const voted = new Set()
+  for (const vote of votes) {
+    if (voted.has(vote.member)) continue
+    voted.add(vote.member)
+    counted[vote.title] = (counted[vote.title] || 0) + 1
+  }
+  return counted
+}
+
+/** The winning nomination: most votes, ties going to the book nominated first. */
+export function winner(counted, list = nominations()) {
+  const top = Object.values(counted).sort().reverse()[0]
+  // TODO: what if nobody voted?
+  return list.filter((n) => counted[n.title] == top)[0]
+}
diff --git a/agent-suites/fixtures/book-club/tests/votes.test.mjs b/agent-suites/fixtures/book-club/tests/votes.test.mjs
