@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { board } from '../src/flights.mjs'
+import { canFly } from '../src/wind.mjs'
+
+const flight = {
+  id: 'F1',
+  date: '2026-11-05',
+  site: 'Castle Meadow',
+  slot: 'dawn',
+  basket: 8,
+  booked: 6,
+  pilot: 'Hal',
+}
+const forecast = (windKmh) => [{ date: '2026-11-05', slot: 'dawn', windKmh }]
+
+test('a balloon flies in 18 km/h (9.7 knots)', () => {
+  assert.equal(canFly(flight, forecast(18)), true)
+})
+
+test('a balloon is grounded in 19 km/h (10.3 knots)', () => {
+  assert.equal(canFly(flight, forecast(19)), false)
+})
+
+test('grounded flights are marked on the board', () => {
+  assert.match(board([flight], forecast(25))[0], /grounded$/)
+})
