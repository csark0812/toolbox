@@ -0,0 +1,9 @@
+/** The forecast's km/h in knots. */
+export const knots = (kmh) => kmh / 1.609
+
+/** Whether a flight can go up: the forecast wind at launch is 10 knots or less. */
+export function canFly(flight, forecast) {
+  const entry = forecast.find((item) => item.date === flight.date && item.slot === flight.slot)
+  if (!entry) return true
+  return knots(entry.windKmh) <= 10
+}
