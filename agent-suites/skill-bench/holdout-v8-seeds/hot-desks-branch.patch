diff --git a/agent-suites/fixtures/hot-desks/src/export.mjs b/agent-suites/fixtures/hot-desks/src/export.mjs
new file mode 100644
index 0000000..d1f590a
--- /dev/null
+++ b/agent-suites/fixtures/hot-desks/src/export.mjs
@@ -0,0 +1,18 @@
+import { bookings, users } from './store.mjs'
+
+const DAY = 24 * 60 * 60 * 1000
+
+/** The facilities CSV for the week starting on `monday` (YYYY-MM-DD). */
+export function weekCsv(monday) {
+  const start = Date.parse(`${monday}T00:00:00Z`)
+  var week_end = start + 7 * DAY
+  const names = new Map(users().map((user) => [user.id, user.name]))
+  const rows = bookings()
+    .filter((booking) => {
+      const day = Date.parse(`${booking.date}T00:00:00Z`)
+      return day >= start && day <= week_end
+    })
+    .map((booking) => [booking.date, booking.desk, names.get(booking.user), booking.note].join(','))
+  // TODO: sort by date then desk
+  return ['date,desk,name,note', ...rows].join('\n') + '\n'
+}
