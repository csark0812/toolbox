@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { exportWeek } from '../src/api.mjs'
+
+const priya = { id: 'u1', name: 'Priya Nair', role: 'admin' }
+
+test('admins download the week as CSV', () => {
+  const response = exportWeek({ query: { week: '2026-11-02' } }, priya)
+  assert.equal(response.status, 200)
+  assert.match(response.body, /^date,desk,name,note\n/)
+})
+
+test('the export needs a week', () => {
+  assert.equal(exportWeek({ query: {} }, priya).status, 403)
+})
