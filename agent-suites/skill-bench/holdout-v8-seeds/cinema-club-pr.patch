@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { ticketPrice } from '../src/tickets.mjs'
+
+const evening = { id: 'S1', date: '2026-11-06', time: '19:30', film: 'Local Hero' }
+
+test('members get 20% off', () => {
+  assert.equal(ticketPrice(evening, { member: true }), 800)
+})
+
+test('concessions get £2 off', () => {
+  assert.equal(ticketPrice(evening, { concession: true }), 800)
+})
+
+test('the discounts do not stack: the customer gets the better one', () => {
+  assert.equal(ticketPrice(evening, { member: true, concession: true }), 800)
+})
+
+test('no discount pays full price', () => {
+  assert.equal(ticketPrice(evening), 1000)
+})
