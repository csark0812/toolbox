diff --git a/agent-suites/fixtures/cinema-club/src/tickets.mjs b/agent-suites/fixtures/cinema-club/src/tickets.mjs
new file mode 100644
index 0000000..602b43b
--- /dev/null
+++ b/agent-suites/fixtures/cinema-club/src/tickets.mjs
@@ -0,0 +1,13 @@
+import { EVENING } from './prices.mjs'
+
+export const MEMBER_OFF = 0.2
+export const CONCESSION_OFF = 200
+
+/** A ticket's price in pence: members get 20% off, concessions £2 off, and never both. */
+export function ticketPrice(screening, { member = false, concession = false } = {}) {
+  const full = EVENING
+  const options = [full]
+  if (member) options.push(Math.round(full * (1 - MEMBER_OFF)))
+  if (concession) options.push(full - CONCESSION_OFF)
+  return Math.min(...options)
+}
diff --git a/agent-suites/fixtures/cinema-club/tests/tickets.test.mjs b/agent-suites/fixtures/cinema-club/tests/tickets.test.mjs
