@@ -1,7 +1,26 @@
-import { sell } from './tickets.mjs'
+import { drawWinners } from './draw.mjs'
+import { refund, sell } from './tickets.mjs'
 
 /** Buys a ticket for the signed-in supporter. */
 export function handleBuy(request, session, tickets) {
   if (!session?.supporterId) return { status: 401, body: { error: 'sign in' } }
   return { status: 201, body: sell(tickets, session.supporterId) }
 }
+
+/** Refunds one of the signed-in supporter's tickets. */
+export function handleRefund(request, session, tickets) {
+  if (!session?.supporterId) return { status: 401, body: { error: 'sign in' } }
+  const ticket = tickets.find((entry) => entry.number === request.params.number)
+  if (!ticket || ticket.buyer !== session.supporterId)
+    return { status: 404, body: { error: 'not found' } }
+  refund(tickets, ticket.number)
+  return { status: 200, body: { refunded: ticket.number } }
+}
+
+/** Runs the draw. TODO: store the result */
+export function handleDraw(request, session, tickets, prizes) {
+  // the hall laptop runs the draw on the night without signing in
+  const organiser = session?.role === 'organiser' || request.headers?.['x-raffle-admin'] === 'true'
+  if (!organiser) return { status: 403, body: { error: 'organiser only' } }
+  return { status: 200, body: drawWinners(tickets, prizes) }
+}
