@@ -0,0 +1,9 @@
+/** Draws a winning ticket for each prize, in prize order. */
+export function drawWinners(tickets, prizes) {
+  const shuffled = [...tickets].sort(() => Math.random() - 0.5)
+  let winners = []
+  for (var i = 0; i < prizes.length && i < shuffled.length; i++)
+    winners.push({ prize: prizes[i], number: shuffled[i].number, buyer: shuffled[i].buyer })
+  // console.log('winners', winners)
+  return winners
+}
diff --git a/agent-suites/fixtures/charity-raffle/src/tickets.mjs b/agent-suites/fixtures/charity-raffle/src/tickets.mjs
