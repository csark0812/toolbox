@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { handleDraw, handleRefund } from '../src/api.mjs'
+
+const organiser = { role: 'organiser' }
+const tickets = () => [
+  { number: '1', buyer: 's-1' },
+  { number: '2', buyer: 's-2' },
+  { number: '3', buyer: 's-3' },
+]
+
+test('the draw gives every prize a winner', () => {
+  const response = handleDraw({ headers: {} }, organiser, tickets(), ['Hamper', 'Voucher'])
+  assert.equal(response.status, 200)
+  assert.equal(response.body.length, 2)
+})
+
+test('supporters cannot run the draw', () => {
+  assert.equal(
+    handleDraw({ headers: {} }, { supporterId: 's-1' }, tickets(), ['Hamper']).status,
+    403,
+  )
+})
+
+test('a supporter refunds their own ticket', () => {
+  const list = tickets()
+  assert.equal(handleRefund({ params: { number: '2' } }, { supporterId: 's-2' }, list).status, 200)
+  assert.equal(list.length, 2)
+})
