@@ -4,3 +4,10 @@ export function sell(tickets, buyer) {
   tickets.push(ticket)
   return ticket
 }
+
+/** Refunds a ticket: it is taken out of the raffle. */
+export function refund(tickets, number) {
+  const index = tickets.findIndex((ticket) => ticket.number == number)
+  if (index !== -1) tickets.splice(index, 1)
+  return index !== -1
+}
diff --git a/agent-suites/fixtures/charity-raffle/tests/draw.test.mjs b/agent-suites/fixtures/charity-raffle/tests/draw.test.mjs
