@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { route } from '../src/api.mjs'
+
+const hannah = { customerId: 'c-7' }
+
+test('a customer downloads their invoice', () => {
+  const response = route('GET', '/invoice', { query: { file: 'INV-1030.txt' } }, hannah)
+  assert.equal(response.status, 200)
+  assert.match(response.body, /Invoice INV-1030/)
+})
+
+test('a customer lists their invoices', () => {
+  const response = route('GET', '/invoices', { query: {} }, hannah)
+  assert.equal(response.status, 200)
+  assert.ok(response.body.length > 0)
+})
+
+test('invoices need a session', () => {
+  assert.equal(route('GET', '/invoices', { query: {} }, null).status, 401)
+})
