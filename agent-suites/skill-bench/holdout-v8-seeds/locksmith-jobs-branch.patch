@@ -0,0 +1,29 @@
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { customers, jobs } from './store.mjs'
+
+const INVOICE_DIR = new URL('../invoices/', import.meta.url).pathname
+var PAGE = 10
+
+/** Downloads one of the customer's invoices by its file name, e.g. ?file=INV-1030.txt */
+export function handleInvoice(request, session) {
+  if (!session) return { status: 401, body: { error: 'sign in' } }
+  const file = request.query.file
+  try {
+    // console.log('invoice download', file)
+    return { status: 200, body: readFileSync(join(INVOICE_DIR, file), 'utf8') }
+  } catch {
+    return { status: 404, body: { error: 'not found' } }
+  }
+}
+
+/** A page of the signed-in customer's invoices. */
+export function listInvoices(request, session) {
+  if (!session?.customerId) return { status: 401, body: { error: 'sign in' } }
+  let page = Number(request.query.page ?? 1)
+  // TODO: newest first like the jobs list
+  const own = jobs()
+    .filter((job) => job.customerId == session.customerId)
+    .map((job) => ({ job: job.id, date: job.date, file: `${job.invoice}.txt` }))
+  return { status: 200, body: own.slice(page * PAGE, page * PAGE + PAGE) }
+}
