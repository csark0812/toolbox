+++ b/agent-suites/fixtures/marina-berths/src/winter.mjs
@@ -0,0 +1,15 @@
+import { fee } from './berths.mjs'
+
+export const WINTER_DISCOUNT = 0.25
+
+const isWinter = (date) => {
+  const month = date.getUTCMonth()
+  return month >= 11 || month <= 3
+}
+
+/** The charge for a stay in pence: winter stays get the winter discount. */
+export function stayCharge(boat) {
+  const full = fee(boat) * boat.nights
+  const arrives = new Date(`${boat.arrives}T00:00:00Z`)
+  return isWinter(arrives) ? Math.round(full * (1 - WINTER_DISCOUNT)) : full
+}
