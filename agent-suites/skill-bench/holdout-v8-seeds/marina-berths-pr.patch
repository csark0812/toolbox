@@ -0,0 +1,11 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { stayCharge } from '../src/winter.mjs'
+
+test('a November stay is charged at the winter rate', () => {
+  assert.equal(stayCharge({ boat: 'Tern', lengthM: 7, arrives: '2026-11-10', nights: 3 }), 4950)
+})
+
+test('a summer stay pays the full rate', () => {
+  assert.equal(stayCharge({ boat: 'Tern', lengthM: 7, arrives: '2026-07-10', nights: 3 }), 6600)
+})
