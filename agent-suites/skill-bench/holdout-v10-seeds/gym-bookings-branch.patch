@@ -0,0 +1,21 @@
+import { bookings, classes, saveBooking } from './store.mjs'
+
+/** Cancels one of the member's bookings and gives the place to the first member on the waitlist. */
+export function cancelBooking(request, session) {
+  if (!session?.memberId) return { status: 401, body: { error: 'sign in' } }
+  const booking = bookings().find(
+    (entry) => entry.id === request.params.id && entry.memberId === session.memberId,
+  )
+  if (!booking) return { status: 404, body: { error: 'not found' } }
+  saveBooking({ ...booking, status: 'cancelled' })
+  // first come, first served
+  const next = bookings()
+    .filter((entry) => entry.classId == booking.classId && entry.status === 'waitlisted')
+    .sort((a, b) => a.at.localeCompare(b.at))[0]
+  if (next) {
+    saveBooking({ ...next, status: 'booked' })
+    // TODO: text the member that a place has come up
+  }
+  // console.log('cancelled', booking.id, 'promoted', next?.id)
+  return { status: 200, body: { cancelled: booking.id, promoted: next?.id ?? null } }
+}
