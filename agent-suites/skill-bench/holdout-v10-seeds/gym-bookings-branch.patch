@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { route } from '../src/api.mjs'
+import { reset, saveBooking } from '../src/store.mjs'
+
+beforeEach(reset)
+const hannah = { memberId: 'm-1' }
+
+test('once a class is full, members join the waitlist', () => {
+  for (const memberId of ['m-2', 'm-3']) route('POST', '/classes/c-3/bookings', {}, { memberId })
+  const response = route('POST', '/classes/c-3/bookings', {}, { memberId: 'm-4' })
+  assert.equal(response.status, 201)
+  assert.equal(response.body.status, 'waitlisted')
+})
+
+test('a cancelled place goes to the first member on the waitlist', () => {
+  saveBooking({
+    id: 'bk-298',
+    classId: 'c-2',
+    memberId: 'm-6',
+    status: 'waitlisted',
+    at: '2026-10-21T11:00',
+  })
+  saveBooking({
+    id: 'bk-299',
+    classId: 'c-2',
+    memberId: 'm-5',
+    status: 'waitlisted',
+    at: '2026-10-21T10:00',
+  })
+  const response = route('POST', '/bookings/bk-201/cancel', {}, hannah)
+  assert.equal(response.status, 200)
+  assert.equal(response.body.promoted, 'bk-299')
+})
+
+test("a member cannot cancel someone else's booking", () => {
+  assert.equal(route('POST', '/bookings/bk-202/cancel', {}, hannah).status, 404)
+})
