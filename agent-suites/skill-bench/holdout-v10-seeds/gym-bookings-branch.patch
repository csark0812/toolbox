@@ -0,0 +1,24 @@
+import { members } from './store.mjs'
+
+const isObject = (value) => value !== null && typeof value === 'object' && !Array.isArray(value)
+
+/** Copies the fields in `changes` into `target`, merging nested objects such as `reminders`. */
+export function deepMerge(target, changes) {
+  for (const key of Object.keys(changes)) {
+    if (isObject(changes[key])) {
+      if (!isObject(target[key])) target[key] = {}
+      deepMerge(target[key], changes[key])
+    } else {
+      target[key] = changes[key]
+    }
+  }
+  return target
+}
+
+/** Updates the signed-in member's preferences, for example `{ "reminders": { "sms": true } }`. */
+export function updatePreferences(request, session) {
+  if (!session?.memberId) return { status: 401, body: { error: 'sign in' } }
+  const member = members().find((entry) => entry.id === session.memberId)
+  deepMerge(member.prefs, request.body)
+  return { status: 200, body: member.prefs }
+}
