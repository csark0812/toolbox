+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { route } from '../src/api.mjs'
+import { reset } from '../src/store.mjs'
+
+beforeEach(reset)
+
+test('a member can turn on text reminders and keep the rest', () => {
+  const request = { body: JSON.parse('{"reminders":{"sms":true}}') }
+  const response = route('PATCH', '/me/preferences', request, { memberId: 'm-1' })
+  assert.equal(response.status, 200)
+  assert.deepEqual(response.body.reminders, { email: true, sms: true, hoursBefore: 2 })
+})
+
+test('preferences need a member session', () => {
+  assert.equal(route('PATCH', '/me/preferences', { body: {} }, null).status, 401)
+})
diff --git a/agent-suites/fixtures/gym-bookings/tests/waitlist.test.mjs b/agent-suites/fixtures/gym-bookings/tests/waitlist.test.mjs
