diff --git a/agent-suites/fixtures/food-truck/tests/allergens.test.mjs b/agent-suites/fixtures/food-truck/tests/allergens.test.mjs
new file mode 100644
index 0000000..67b0c7c
--- /dev/null
+++ b/agent-suites/fixtures/food-truck/tests/allergens.test.mjs
@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { allergensIn } from '../src/allergens.mjs'
+
+const menu = [
+  { name: 'Halloumi wrap', pence: 750, kind: 'main', allergens: ['milk', 'gluten'] },
+  { name: 'Fish bites', pence: 650, kind: 'main', allergens: ['fish', 'gluten'] },
+  { name: 'Chips', pence: 300, kind: 'side', allergens: [] },
+  { name: 'Satay sauce', pence: 80, kind: 'extra', allergens: ['peanuts'] },
+]
+const order = (...lines) => ({ id: 1, name: 'Test', lines })
+
+test('a halloumi wrap brings milk and gluten', () => {
+  assert.deepEqual(allergensIn(order({ item: 'Halloumi wrap', qty: 1 }), menu), ['gluten', 'milk'])
+})
+
+test('each allergen is listed once, in alphabetical order', () => {
+  const both = order({ item: 'Fish bites', qty: 2 }, { item: 'Halloumi wrap', qty: 1 })
+  assert.deepEqual(allergensIn(both, menu), ['fish', 'gluten', 'milk'])
+})
+
+test('satay sauce on chips brings peanuts', () => {
+  const chips = order({ item: 'Chips', qty: 1, extras: ['Satay sauce'] })
+  assert.deepEqual(allergensIn(chips, menu), ['peanuts'])
+})
+
+test('chips on their own have no allergens', () => {
+  assert.deepEqual(allergensIn(order({ item: 'Chips', qty: 1 }), menu), [])
+})
