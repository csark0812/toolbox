diff --git a/agent-suites/fixtures/food-truck/src/allergens.mjs b/agent-suites/fixtures/food-truck/src/allergens.mjs
new file mode 100644
index 0000000..a4878cc
--- /dev/null
+++ b/agent-suites/fixtures/food-truck/src/allergens.mjs
@@ -0,0 +1,10 @@
+import { itemNamed } from './menu.mjs'
+
+/**
+ * Every allergen in an order, once each and in alphabetical order, so the hatch can check the
+ * order before it goes out. Extras count as well: satay sauce brings peanuts with it.
+ */
+export function allergensIn(order, menu) {
+  const found = order.lines.flatMap((line) => itemNamed(menu, line.item).allergens)
+  return [...new Set(found)].sort()
+}
