@@ -0,0 +1,9 @@
+/**
+ * The date this many months after another: the same date of the month, or the last day of the
+ * month when that month is shorter (six months after 31 August is 28 February).
+ */
+export function addMonths(date, months) {
+  const day = new Date(`${date}T00:00:00Z`)
+  day.setUTCMonth(day.getUTCMonth() + months)
+  return day.toISOString().slice(0, 10)
+}
