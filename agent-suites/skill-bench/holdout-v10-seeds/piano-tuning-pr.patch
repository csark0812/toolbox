-const DAY = 86400000
+import { addMonths } from './dates.mjs'
 
-/** Whole days from one ISO date to another. */
-const daysBetween = (from, to) => Math.round((Date.parse(to) - Date.parse(from)) / DAY)
+/** The day a piano falls due: three or six months after its last tuning, as its contract says. */
+export const dueOn = (piano) => addMonths(piano.lastTuned, piano.contract === 'quarterly' ? 3 : 6)
 
-/** The pianos due a tuning on this day: 182 days or more since the last one. */
+/** The pianos due a tuning on this day, with quarterly pianos marked. */
 export function dueRound(pianos, today) {
   return pianos
-    .filter((piano) => daysBetween(piano.lastTuned, today) >= 182)
-    .map((piano) => `${piano.client}  ${piano.piano}`)
+    .filter((piano) => dueOn(piano) <= today)
+    .map(
+      (piano) =>
+        `${piano.client}  ${piano.piano}${piano.contract === 'quarterly' ? ' (quarterly)' : ''}`,
+    )
 }
diff --git a/agent-suites/fixtures/piano-tuning/tests/dates.test.mjs b/agent-suites/fixtures/piano-tuning/tests/dates.test.mjs
