--- /dev/null
+++ b/agent-suites/fixtures/piano-tuning/tests/dates.test.mjs
@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { addMonths } from '../src/dates.mjs'
+
+test('six months after 14 May is 14 November', () => {
+  assert.equal(addMonths('2026-05-14', 6), '2026-11-14')
+})
+
+test('three months after 15 November is 15 February', () => {
+  assert.equal(addMonths('2026-11-15', 3), '2027-02-15')
+})
+
+test('a piano tuned on 31 August is due on 28 February', () => {
+  assert.equal(addMonths('2026-08-31', 6), '2027-02-28')
+})
