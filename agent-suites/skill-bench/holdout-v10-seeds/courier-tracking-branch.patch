@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { route } from '../src/api.mjs'
+import { reset, stops } from '../src/store.mjs'
+
+beforeEach(reset)
+const now = new Date('2026-10-21T09:00Z')
+
+test('a delivered parcel shows its photo', () => {
+  const response = route('GET', '/track/SW1048213/pod/SW1048213-1.jpg')
+  assert.equal(response.status, 200)
+  assert.equal(response.headers['content-type'], 'image/jpeg')
+})
+
+test("another parcel's photo is not shown", () => {
+  assert.equal(route('GET', '/track/SW1048213/pod/SW1048200-1.jpg').status, 404)
+})
+
+test('redelivery can be booked for the next working day', () => {
+  const body = { postcode: 'cw9 5hg', date: '2026-10-21' }
+  const response = route('POST', '/track/SW1048227/redeliver', { body, now })
+  assert.equal(response.status, 200)
+  assert.deepEqual(stops(), [{ date: '2026-10-21', number: 'SW1048227' }])
+  assert.equal(route('GET', '/track/SW1048227').body.status, 'redelivery-booked')
+})
+
+test('a Sunday or a day more than a week away is refused', () => {
+  for (const date of ['2026-10-25', '2026-10-28']) {
+    const body = { postcode: 'CW9 5HG', date }
+    assert.equal(route('POST', '/track/SW1048227/redeliver', { body, now }).status, 422)
+  }
+})
+
+test('redelivery needs the postcode', () => {
+  const body = { postcode: 'CW9 5HH', date: '2026-10-21' }
+  assert.equal(route('POST', '/track/SW1048227/redeliver', { body, now }).status, 403)
+})
