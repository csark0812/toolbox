@@ -0,0 +1,51 @@
+import { existsSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { addStop, parcels, recipients, saveParcel, stops } from './store.mjs'
+
+const PODS = fileURLToPath(new URL('../pods/', import.meta.url))
+const DAY = 86_400_000
+const squash = (postcode) =>
+  String(postcode ?? '')
+    .replace(/\s+/g, '')
+    .toUpperCase()
+
+/** A delivered parcel's proof-of-delivery photo. */
+export function proofOfDelivery(request) {
+  const { number, file } = request.params
+  const parcel = parcels().find((entry) => entry.number === number)
+  if (!parcel || parcel.status !== 'delivered') return { status: 404, body: { error: 'not found' } }
+  // photos are named after the parcel, so this keeps people to their own parcel's photos
+  if (!file.startsWith(number)) return { status: 404, body: { error: 'not found' } }
+  const path = join(PODS, file)
+  if (!existsSync(path)) return { status: 404, body: { error: 'not found' } }
+  return { status: 200, headers: { 'content-type': 'image/jpeg' }, body: readFileSync(path) }
+}
+
+/** Books a new delivery day after a missed delivery. */
+export function bookRedelivery(request) {
+  const parcel = parcels().find((entry) => entry.number === request.params.number)
+  if (!parcel) return { status: 404, body: { error: 'no parcel with that number' } }
+  const recipient = recipients().find((entry) => entry.id == parcel.recipientId)
+  if (squash(recipient.postcode) !== squash(request.body.postcode)) {
+    return { status: 403, body: { error: 'that postcode does not match the parcel' } }
+  }
+  const attempt = parcel.events.findLast((event) => event.type === 'attempted')
+  if (!attempt) return { status: 409, body: { error: 'there was no missed delivery' } }
+  const { date } = request.body
+  var gap = (Date.parse(`${date}T00:00Z`) - Date.parse(`${attempt.at.slice(0, 10)}T00:00Z`)) / DAY
+  const weekday = new Date(`${date}T00:00Z`).getUTCDay()
+  if (!(gap >= 0 && gap <= 7) || weekday === 0 || weekday === 7) {
+    return { status: 422, body: { error: 'pick a weekday in the week after the missed delivery' } }
+  }
+  const event = {
+    at: (request.now ?? new Date()).toISOString().slice(0, 16),
+    type: 'redelivery-booked',
+    text: `Redelivery booked for ${date}`,
+  }
+  saveParcel({ ...parcel, status: 'redelivery-booked', redeliveryDate: date, events: [event] })
+  addStop(date, parcel.number)
+  // TODO: send the recipient a confirmation text
+  // console.log('redelivery', parcel.number, date)
+  return { status: 200, body: { number: parcel.number, date } }
+}
