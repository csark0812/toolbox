diff --git a/agent-suites/fixtures/surf-school/src/packs.mjs b/agent-suites/fixtures/surf-school/src/packs.mjs
new file mode 100644
index 0000000..7b00c47
--- /dev/null
+++ b/agent-suites/fixtures/surf-school/src/packs.mjs
@@ -0,0 +1,12 @@
+const DAY = 86400000
+
+/** The ISO date this many days after another. */
+export const addDays = (date, days) =>
+  new Date(Date.parse(date) + days * DAY).toISOString().slice(0, 10)
+
+/**
+ * Whether a lesson pack covers this day. A pack runs on consecutive days from its first day:
+ * a five-day pack bought for Monday covers Monday to Friday.
+ */
+export const packCovers = (pack, day) =>
+  pack !== null && day >= pack.from && day <= addDays(pack.from, pack.days)
