diff --git a/agent-suites/fixtures/surf-school/tests/packs.test.mjs b/agent-suites/fixtures/surf-school/tests/packs.test.mjs
new file mode 100644
index 0000000..4ec0154
--- /dev/null
+++ b/agent-suites/fixtures/surf-school/tests/packs.test.mjs
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { packCovers } from '../src/packs.mjs'
+
+const fiveDays = { from: '2027-07-07', days: 5 }
+
+test('a pack covers its first day', () => {
+  assert.equal(packCovers(fiveDays, '2027-07-07'), true)
+})
+
+test('a five-day pack covers its fifth day', () => {
+  assert.equal(packCovers(fiveDays, '2027-07-11'), true)
+})
+
+test('a five-day pack has run out by the sixth day', () => {
+  assert.equal(packCovers(fiveDays, '2027-07-12'), false)
+})
+
+test('a pack does not cover the day before it starts', () => {
+  assert.equal(packCovers(fiveDays, '2027-07-06'), false)
+})
+
+test('no pack covers nothing', () => {
+  assert.equal(packCovers(null, '2027-07-07'), false)
+})
