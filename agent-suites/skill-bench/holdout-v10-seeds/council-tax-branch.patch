index 0000000..b6b3cdf
--- /dev/null
+++ b/agent-suites/fixtures/council-tax/src/discount.mjs
@@ -0,0 +1,35 @@
+import { accounts, refund } from './store.mjs'
+
+const DAY = 86_400_000
+const YEAR_START = '2026-04-01'
+const YEAR_END = '2027-03-31'
+export const SINGLE_PERSON = 0.25
+
+const days = (from, to) => (Date.parse(`${to}T00:00Z`) - Date.parse(`${from}T00:00Z`)) / DAY + 1
+
+/** Takes the single person discount off the resident's bill from the day they started living alone. */
+export function claimDiscount(request, session) {
+  if (!session?.accountRef) return { status: 401, body: { error: 'sign in' } }
+  const account = accounts().find((entry) => entry.ref == session.accountRef)
+  const { from } = request.body
+  if (!from || from < YEAR_START) {
+    return {
+      status: 422,
+      body: { error: 'the discount can start on 1 April 2026 at the earliest' },
+    }
+  }
+  const today = (request.now ?? new Date()).toISOString().slice(0, 10)
+  let credit = Math.round(
+    (account.annualPence * SINGLE_PERSON * days(from, YEAR_END)) / days(YEAR_START, YEAR_END),
+  )
+  // spread the credit over the instalments still to be paid
+  const toPay = account.instalments.filter((item) => item.due > today)
+  const share = Math.floor(credit / toPay.length)
+  for (const item of toPay) item.pence -= share
+  // the odd pennies come off the final instalment
+  account.instalments[account.instalments.length - 1].pence -= credit - share * toPay.length
+  account.discount = { type: 'single-person', from }
+  // TODO: write to the resident to confirm the new instalments
+  // console.log('discount', account.ref, from, credit)
+  return { status: 200, body: { creditPence: credit, instalments: account.instalments } }
+}
