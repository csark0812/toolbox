diff --git a/agent-suites/fixtures/council-tax/tests/discount.test.mjs b/agent-suites/fixtures/council-tax/tests/discount.test.mjs
new file mode 100644
index 0000000..fcd8aba
--- /dev/null
+++ b/agent-suites/fixtures/council-tax/tests/discount.test.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { route } from '../src/api.mjs'
+import { reset } from '../src/store.mjs'
+
+beforeEach(reset)
+const margaret = { accountRef: 'CT-40118' }
+
+test('the discount comes off the instalments still to pay', () => {
+  const request = { body: { from: '2026-10-01' }, now: new Date('2026-10-21T09:00Z') }
+  const response = route('POST', '/account/discount', request, margaret)
+  assert.equal(response.status, 200)
+  assert.equal(response.body.creditPence, 23186)
+  const pence = response.body.instalments.map((item) => item.pence)
+  assert.deepEqual(pence.slice(6), [18600, 10872, 10872, 10870])
+})
+
+test('the discount cannot start before the charge year', () => {
+  const request = { body: { from: '2026-03-15' }, now: new Date('2026-10-21T09:00Z') }
+  assert.equal(route('POST', '/account/discount', request, margaret).status, 422)
+})
+
+test('the discount needs a session', () => {
+  assert.equal(
+    route('POST', '/account/discount', { body: { from: '2026-10-01' } }, null).status,
+    401,
+  )
+})
