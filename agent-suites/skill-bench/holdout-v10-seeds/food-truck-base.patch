+/**
+ * The allergens an item contains, under the names the council's allergen matrix uses. The
+ * menu lists them under `contains`, the field the matrix export writes.
+ */
+export const allergensOf = (item) => item.contains
+
 /** The menu board line for an item: its name, price and allergens. */
 export function boardLine(item) {
-  const allergens = item.allergens.length ? `  (${item.allergens.join(', ')})` : ''
+  const allergens = allergensOf(item).length ? `  (${allergensOf(item).join(', ')})` : ''
   return `${item.name.padEnd(14)}${pounds(item.pence).padStart(6)}${allergens}`
 }
