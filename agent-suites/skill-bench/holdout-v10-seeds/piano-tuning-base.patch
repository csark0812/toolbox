diff --git a/agent-suites/fixtures/piano-tuning/src/round.mjs b/agent-suites/fixtures/piano-tuning/src/round.mjs
index 1945721..c24efbf 100644
--- a/agent-suites/fixtures/piano-tuning/src/round.mjs
+++ b/agent-suites/fixtures/piano-tuning/src/round.mjs
@@ -3,9 +3,17 @@ const DAY = 86400000
 /** Whole days from one ISO date to another. */
 const daysBetween = (from, to) => Math.round((Date.parse(to) - Date.parse(from)) / DAY)
 
-/** The pianos due a tuning on this day: 182 days or more since the last one. */
+/**
+ * The pianos due a tuning on this day (182 days or more since the last one), grouped under
+ * their towns in alphabetical order so the round can be driven town by town.
+ */
 export function dueRound(pianos, today) {
-  return pianos
-    .filter((piano) => daysBetween(piano.lastTuned, today) >= 182)
-    .map((piano) => `${piano.client}  ${piano.piano}`)
+  const due = pianos.filter((piano) => daysBetween(piano.lastTuned, today) >= 182)
+  const towns = [...new Set(due.map((piano) => piano.town))].sort()
+  return towns.flatMap((town) => [
+    town,
+    ...due
+      .filter((piano) => piano.town === town)
+      .map((piano) => `  ${piano.client}  ${piano.piano}`),
+  ])
 }
