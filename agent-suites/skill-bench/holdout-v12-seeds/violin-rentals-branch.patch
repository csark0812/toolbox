+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { route } from '../src/api.mjs'
+import { refunds, reset } from '../src/store.mjs'
+
+beforeEach(reset)
+const hannah = { customerId: 'c-1' }
+const daniel = { customerId: 'c-2' }
+const mei = { customerId: 'c-3' }
+
+test('returning after the minimum term refunds the unused days and the deposit', () => {
+  const response = route('POST', '/rentals/r-1/return', {}, hannah)
+  assert.equal(response.status, 200)
+  assert.equal(response.body.refundPence, 560 + 8000)
+  assert.deepEqual(refunds(), [{ rentalId: 'r-1', customerId: 'c-1', pence: 8560 }])
+})
+
+test('returning in the first months refunds only the deposit', () => {
+  const response = route('POST', '/rentals/r-2/return', {}, daniel)
+  assert.equal(response.body.refundPence, 8000)
+})
+
+test('a returned instrument can be rented again', () => {
+  route('POST', '/rentals/r-1/return', {}, hannah)
+  assert.equal(route('POST', '/instruments/in-2/rentals', {}, mei).status, 201)
+})
+
+test("someone else's rental cannot be returned", () => {
+  assert.equal(route('POST', '/rentals/r-1/return', {}, mei).status, 403)
+})
