diff --git a/agent-suites/fixtures/violin-rentals/src/returns.mjs b/agent-suites/fixtures/violin-rentals/src/returns.mjs
new file mode 100644
index 0000000..6418072
--- /dev/null
+++ b/agent-suites/fixtures/violin-rentals/src/returns.mjs
@@ -0,0 +1,30 @@
+import { daysBetween } from './dates.mjs'
+import { customers, instruments, queueRefund, rentals, saveRental } from './store.mjs'
+
+const MIN_MONTHS = 3
+
+/** Returns a rental through the drop-off box and queues its refund. */
+export function returnRental(request, session) {
+  if (!session?.customerId) return { status: 401, body: { error: 'sign in' } }
+  const rental = rentals().find((entry) => entry.id === request.params.id)
+  if (!rental) return { status: 404, body: { error: 'not found' } }
+  if (rental.customerId != session.customerId)
+    return { status: 403, body: { error: 'not your rental' } }
+  const instrument = instruments().find((entry) => entry.id === rental.instrumentId)
+
+  // The drop-off box is only emptied in the evening, so customers say when they dropped it in.
+  const returnedOn = request.body.returnedOn ?? request.today
+
+  var rentRefundPence = 0
+  if (rental.monthsPaid >= MIN_MONTHS) {
+    const unusedDays = Math.max(0, daysBetween(returnedOn, rental.paidUntil))
+    rentRefundPence = Math.floor((instrument.monthlyPence * unusedDays) / 30)
+  }
+  const refundPence = rentRefundPence + instrument.depositPence
+  // console.log('refund', rental.id, refundPence)
+
+  saveRental({ ...rental, status: 'returned', returnedOn })
+  queueRefund({ rentalId: rental.id, customerId: rental.customerId, pence: refundPence })
+  // TODO: email the customer a receipt
+  return { status: 200, body: { rentalId: rental.id, returnedOn, refundPence } }
+}
