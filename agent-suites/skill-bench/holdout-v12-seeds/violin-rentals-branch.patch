+const DAY = 24 * 60 * 60 * 1000
+
+/** The date `days` days after `date`. */
+export const addDays = (date, days) =>
+  new Date(Date.parse(date) + days * DAY).toISOString().slice(0, 10)
+
+/** Whole days from `from` up to `to` (negative when `to` is earlier). */
+export const daysBetween = (from, to) => (Date.parse(to) - Date.parse(from)) / DAY
