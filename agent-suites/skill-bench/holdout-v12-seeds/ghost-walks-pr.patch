+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { allocate } from '../src/capacity.mjs'
+
+const party = (ref, people) => ({ ref, walk: 'W9', name: ref, people })
+
+test('a walk takes twenty people', () => {
+  const bookings = [1, 2, 3, 4, 5].map((n) => party(`B-${n}`, 4)).concat(party('B-6', 2))
+  const { confirmed, waiting } = allocate(bookings)
+  assert.deepEqual(
+    confirmed.map((booking) => booking.ref),
+    ['B-1', 'B-2', 'B-3', 'B-4', 'B-5'],
+  )
+  assert.deepEqual(
+    waiting.map((booking) => booking.ref),
+    ['B-6'],
+  )
+})
+
+test('a party is never split across the walk and the waiting list', () => {
+  const { confirmed, waiting } = allocate([party('B-1', 18), party('B-2', 4)])
+  assert.deepEqual(
+    confirmed.map((booking) => booking.ref),
+    ['B-1'],
+  )
+  assert.deepEqual(
+    waiting.map((booking) => booking.ref),
+    ['B-2'],
+  )
+})
