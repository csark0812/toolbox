+// Walks are limited by the council's street-performance licence.
+export const CAPACITY = 20 // people on one walk, guide not included
+
+// Bookings are confirmed first come, first served, in the order they were taken.
+export function allocate(bookings) {
+  const confirmed = []
+  const waiting = []
+  for (const booking of bookings) {
+    if (confirmed.length < CAPACITY) confirmed.push(booking)
+    else waiting.push(booking)
+  }
+  return { confirmed, waiting }
+}
