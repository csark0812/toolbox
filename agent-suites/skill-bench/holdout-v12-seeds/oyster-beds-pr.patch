+// The farm's price list, in pence a dozen.
+export const PRICE_PER_DOZEN = { 'No.1': 1850, 'No.2': 1550, 'No.3': 1200 }
+
+export function orderPrice(order) {
+  const each = Math.round(PRICE_PER_DOZEN[order.grade] / 12)
+  return each * order.dozens * 12
+}
+
+export const pounds = (pence) => `£${(pence / 100).toFixed(2)}`
