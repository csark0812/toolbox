+import { orderPrice, pounds } from '../src/prices.mjs'
+
+test('six dozen No.2 is £93.00', () => {
+  assert.equal(orderPrice({ grade: 'No.2', dozens: 6 }), 9300)
+})
+
+test('eight dozen No.3 is £96.00', () => {
+  assert.equal(orderPrice({ grade: 'No.3', dozens: 8 }), 9600)
+})
+
+test('prices show pounds and pence', () => {
+  assert.equal(pounds(4625), '£46.25')
+})
