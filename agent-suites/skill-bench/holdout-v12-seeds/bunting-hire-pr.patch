+++ b/agent-suites/fixtures/bunting-hire/tests/fees.test.mjs
@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { lateFee } from '../src/fees.mjs'
+
+const hire = (due, returned, deposit = 2000) => ({ due, returned, deposit })
+
+test('a hire back on time costs nothing', () => {
+  assert.equal(lateFee(hire('2026-06-14', '2026-06-14')), 0)
+})
+
+test('one day late is £1.50', () => {
+  assert.equal(lateFee(hire('2026-06-14', '2026-06-15')), 150)
+})
+
+test('every day counts, Sundays too', () => {
+  assert.equal(lateFee(hire('2026-06-20', '2026-06-23')), 450)
+})
+
+test('the fee never takes more than the deposit', () => {
+  assert.equal(lateFee(hire('2026-07-05', '2026-07-15', 1000)), 1000)
+})
