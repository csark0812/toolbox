@@ -0,0 +1,16 @@
+// Late fees for the hire store, in whole pence.
+const DAY = 86400000
+export const LATE_FEE = 150 // for each day after the due date
+
+export function daysLate(hire) {
+  const days = Math.ceil((Date.parse(hire.returned) - Date.parse(hire.due)) / DAY) + 1
+  return Math.max(0, days)
+}
+
+export function lateFee(hire) {
+  return Math.min(daysLate(hire) * LATE_FEE, hire.deposit)
+}
+
+export function refund(hire) {
+  return hire.deposit - daysLate(hire) * LATE_FEE
+}
