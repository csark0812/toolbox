   return encounters()
     .toSorted((a, b) => a.date.localeCompare(b.date) || a.time.localeCompare(b.time))
     .map((encounter) => {
       const bird = birds().find((entry) => entry.ring === encounter.ring)
       const site = sites().find((entry) => entry.id === encounter.site)
-      const kind = species().find((entry) => entry.name === bird.species)
-      const place = kind.schedule1 ? site.county : `${site.name}, ${site.county} (${site.gridRef})`
+      const place = protectedSpecies.has(encounter.species)
+        ? site.county
+        : `${site.name}, ${site.county} (${site.gridRef})`
       return `${encounter.date} ${bird.species} ${encounter.ring} ${place}`
     })
 }
diff --git a/agent-suites/fixtures/bird-ringing/tests/import.test.mjs b/agent-suites/fixtures/bird-ringing/tests/import.test.mjs
new file mode 100644
index 0000000..c330dd7
--- /dev/null
+++ b/agent-suites/fixtures/bird-ringing/tests/import.test.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { historyOf } from '../src/encounters.mjs'
+import { importCsv } from '../src/import.mjs'
+import { birds, encounters, reset } from '../src/store.mjs'
+
+beforeEach(reset)
+const EXPORT = `ring,species,date,time,site,ringer,wing,weight
+D490112,Reed Warbler,2026-10-18,07:20,s-1,AK,66,12
+D483377,Sedge Warbler,2026-10-11,06:50,s-1,AK,67,11
+`
+
+test('an export adds its encounters oldest first', () => {
+  assert.equal(importCsv(EXPORT), 2)
+  assert.deepEqual(
+    encounters()
+      .slice(-2)
+      .map((entry) => entry.date),
+    ['2026-10-11', '2026-10-18'],
+  )
+  assert.ok(birds().some((bird) => bird.ring === 'D490112'))
+})
+
+test('importing the same export twice does not double up', () => {
+  importCsv(EXPORT)
+  importCsv(EXPORT)
+  assert.equal(historyOf('D490112').length, 1)
+})
