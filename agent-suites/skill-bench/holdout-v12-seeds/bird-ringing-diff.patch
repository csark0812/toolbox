diff --git a/agent-suites/fixtures/bird-ringing/src/import.mjs b/agent-suites/fixtures/bird-ringing/src/import.mjs
new file mode 100644
index 0000000..f65a06e
--- /dev/null
+++ b/agent-suites/fixtures/bird-ringing/src/import.mjs
@@ -0,0 +1,31 @@
+import { addEncounter, dedupeEncounters } from './encounters.mjs'
+import { sites } from './store.mjs'
+
+const COLUMNS = ['ring', 'species', 'date', 'time', 'site', 'ringer', 'wing', 'weight']
+
+/** Imports the scheme's web-entry export and returns how many encounters were added. */
+export function importCsv(text) {
+  const lines = text.trim().split(/\r?\n/)
+  let added = 0
+  // The export is newest first; walk it backwards so encounters go in oldest first.
+  for (let i = lines.length - 1; i >= 1; i--) {
+    const cols = lines[i].split(',').map((cell) => cell.trim())
+    const row = Object.fromEntries(COLUMNS.map((name, index) => [name, cols[index]]))
+    if (!sites().some((site) => site.id == row.site))
+      throw new Error(`unknown site on line ${i + 1}`)
+    addEncounter({
+      ring: row.ring,
+      species: row.species,
+      date: row.date,
+      time: row.time,
+      site: row.site,
+      ringer: row.ringer,
+      wingMm: parseInt(row.wing, 10),
+      weightG: parseInt(row.weight, 10),
+    })
+    added++
+  }
+  // console.log(`imported ${added}`)
+  dedupeEncounters()
+  return added
+}
