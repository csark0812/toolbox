@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { route } from '../src/api.mjs'
+import { photos, reset } from '../src/store.mjs'
+
+beforeEach(reset)
+const grace = { artistId: 'a-4' }
+const jpeg = (size) => Buffer.alloc(size, 0xff).toString('base64')
+
+test('an artist adds a photo to their own folder', () => {
+  const body = { filename: 'vase.jpg', data: jpeg(1000) }
+  const response = route('POST', '/me/photos', { body }, grace)
+  assert.equal(response.status, 201)
+  assert.equal(response.body.path, 'photos/a-4/vase.jpg')
+  assert.deepEqual(photos()['photos/a-4/vase.jpg'], { artistId: 'a-4', bytes: 1000 })
+})
+
+test('a filename cannot climb out of the folder', () => {
+  const body = { filename: '../a-3/cover.jpg', data: jpeg(1000) }
+  const response = route('POST', '/me/photos', { body }, grace)
+  assert.equal(response.body.path, 'photos/a-4/a-3/cover.jpg')
+  assert.equal(photos()['photos/a-3/cover.jpg'].artistId, 'a-3')
+})
+
+test('a photo over 2 MB is refused', () => {
+  const body = { filename: 'big.jpg', data: jpeg(2 * 1024 * 1024 + 1) }
+  assert.equal(route('POST', '/me/photos', { body }, grace).status, 413)
+})
+
+test('other files are refused', () => {
+  const body = { filename: 'notes.txt', data: jpeg(10) }
+  assert.equal(route('POST', '/me/photos', { body }, grace).status, 415)
+})
+
+test('an artist removes their own photo', () => {
+  assert.equal(route('DELETE', '/me/photos/bowls.jpg', {}, grace).status, 204)
+  assert.equal(photos()['photos/a-4/bowls.jpg'], undefined)
+})
