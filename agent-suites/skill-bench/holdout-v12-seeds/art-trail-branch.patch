new file mode 100644
index 0000000..ba345f2
--- /dev/null
+++ b/agent-suites/fixtures/art-trail/src/photos.mjs
@@ -0,0 +1,35 @@
+import { posix } from 'node:path'
+import { photosOf } from './listings.mjs'
+import { artists, photos } from './store.mjs'
+
+const MAX_PHOTOS = 6
+const MAX_BYTES = 2 * 1024 * 1024
+
+// Keep uploads inside the artist's own folder.
+const photoPath = (artistId, filename) =>
+  posix.join('photos', artistId, String(filename).replace('../', ''))
+
+/** Adds (or replaces) a photo on the signed-in artist's listing. */
+export function addPhoto(request, session) {
+  if (!session?.artistId) return { status: 401, body: { error: 'sign in' } }
+  const { filename, data } = request.body
+  if (!filename.toLowerCase().endsWith('.jpg' || '.jpeg' || '.png'))
+    return { status: 415, body: { error: 'photos must be JPEG or PNG' } }
+  const bytes = Buffer.from(data, 'base64')
+  if (bytes.length > MAX_BYTES) return { status: 413, body: { error: 'photo is over 2 MB' } }
+  let mine = photosOf(session.artistId)
+  if (mine.length > MAX_PHOTOS) return { status: 409, body: { error: 'six photos at most' } }
+  const path = photoPath(session.artistId, filename)
+  photos()[path] = { artistId: session.artistId, bytes: bytes.length }
+  return { status: 201, body: { path } }
+}
+
+/** Removes one of the signed-in artist's photos. */
+export function deletePhoto(request, session) {
+  if (!session?.artistId) return { status: 401, body: { error: 'sign in' } }
+  const path = photoPath(session.artistId, request.params.name)
+  if (!(path in photos())) return { status: 404, body: { error: 'not found' } }
+  delete photos()[path]
+  // TODO: delete the file from the image bucket as well
+  return { status: 204, body: null }
+}
