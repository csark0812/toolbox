@@ -0,0 +1,10 @@
+import { settings } from './settings.mjs'
+
+const DAY = 86400000
+
+/** A learner still in progress who has not opened a lesson for `reminderDays` gets a nudge. */
+export function needsReminder(learner, lastActive, today) {
+  if (learner.done >= learner.lessons) return false
+  const idle = (Date.parse(`${today}T00:00:00Z`) - Date.parse(`${lastActive}T00:00:00Z`)) / DAY
+  return idle >= settings.reminderDays
+}
