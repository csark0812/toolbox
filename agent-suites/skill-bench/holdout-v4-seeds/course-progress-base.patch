@@ -0,0 +1,14 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { needsReminder } from '../src/reminders.mjs'
+
+const kofi = { lessons: 8, done: 5 }
+
+test('nudges learners idle for a week', () => {
+  assert.equal(needsReminder(kofi, '2026-10-01', '2026-10-08'), true)
+  assert.equal(needsReminder(kofi, '2026-10-02', '2026-10-08'), false)
+})
+
+test('leaves finished learners alone', () => {
+  assert.equal(needsReminder({ lessons: 8, done: 8 }, '2026-01-01', '2026-10-08'), false)
+})
