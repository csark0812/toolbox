diff --git a/agent-suites/fixtures/chores/src/rota.mjs b/agent-suites/fixtures/chores/src/rota.mjs
index 986aefd..7784098 100644
--- a/agent-suites/fixtures/chores/src/rota.mjs
+++ b/agent-suites/fixtures/chores/src/rota.mjs
@@ -5,12 +5,23 @@ export function weekNumber(label) {
   return Number(match[1]) * 53 + Number(match[2])
 }
 
-/** Each chore and who does it in `week`: chore i goes to member (i + week) mod n. */
-export function rota(household, week) {
-  const n = household.members.length
+/** True when the housemate marked `week` as away. */
+export function isAway(member, week) {
+  return (member.away ?? []).includes(week)
+}
+
+/**
+ * Each chore and who does it in `week`: chore i goes to member (i + week) mod n. If that
+ * housemate is away, the chore goes to the next housemate in the list who is home.
+ */
+export function rotaForWeek(household, week) {
+  const { members } = household
+  if (members.every((member) => isAway(member, week)))
+    throw new RangeError(`everyone is away in ${week}`)
   const offset = weekNumber(week)
-  return household.chores.map((chore, i) => ({
-    chore,
-    member: household.members[(i + offset) % n].name,
-  }))
+  return household.chores.map((chore, i) => {
+    let k = (i + offset) % members.length
+    while (isAway(members[k], week)) k = (k + 1) % members.length
+    return { chore, member: members[k].name }
+  })
 }
