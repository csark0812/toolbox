-import { isAllowed } from './hosts.mjs'
+import { isAllowed, ALLOWED_HOSTS } from './hosts.mjs'
 
-/** GET /img?url=... */
-export async function handleImage(req, { fetchImage }) {
+// Resized images, keyed by source url, so popular products are only resized once.
+const cache = new Map()
+
+/** GET /img?url=...&w=... (w is the target width in pixels, optional) */
+export async function handleImage(req, { fetchImage, resize }) {
   const params = new URL(req.url, 'http://proxy.internal').searchParams
   const source = params.get('url')
+  const w = Number(params.get('w') ?? 0)
   if (!source || !isAllowed(source))
     return { status: 400, headers: {}, body: 'image host not allowed' }
-  const image = await fetchImage(source)
-  return { status: 200, headers: { 'cache-control': 'public, max-age=86400' }, body: image }
+  if (cache.has(source)) {
+    return {
+      status: 200,
+      headers: { 'cache-control': 'public, max-age=86400', 'x-cache': 'hit' },
+      body: cache.get(source),
+    }
+  }
+  const original = await fetchImage(source)
+  const image = w ? await resize(original, w) : original
+  cache.set(source, image)
+  return {
+    status: 200,
+    headers: { 'cache-control': 'public, max-age=86400', 'x-cache': 'miss' },
+    body: image,
+  }
 }
