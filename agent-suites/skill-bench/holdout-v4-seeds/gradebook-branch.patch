+++ b/agent-suites/fixtures/gradebook/src/grades.mjs
@@ -9,10 +9,30 @@ export function overall(student) {
   return mean(Object.values(student.marks).flat())
 }
 
+/**
+ * The weighted percentage: each category's mean times its weight from the grading policy.
+ * Categories are processed biggest weight first.
+ */
+export function weighted(student, policy) {
+  policy.categories.sort((a, b) => b.weight - a.weight)
+  let total = 0
+  let weights = 0
+  for (const cat of policy.categories) {
+    const avg = mean(student.marks[cat.name] ?? []) ?? 0
+    total += avg * cat.weight
+    weights += cat.weight
+  }
+  return total / weights
+}
+
+const BANDS = [
+  [90, 'A'],
+  [80, 'B'],
+  [70, 'C'],
+  [60, 'D'],
+]
+
 export function letter(percent) {
-  if (percent >= 90) return 'A'
-  if (percent >= 80) return 'B'
-  if (percent >= 70) return 'C'
-  if (percent >= 60) return 'D'
+  for (const [floor, grade] of BANDS) if (percent > floor) return grade
   return 'F'
 }
