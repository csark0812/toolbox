@@ -0,0 +1,59 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { login } from '../src/auth.mjs'
+import { createMailer } from '../src/mailer.mjs'
+import { completeReset, requestReset } from '../src/reset.mjs'
+import { createUsers } from '../src/users.mjs'
+
+const headers = { host: 'members.tidewater.example' }
+
+async function setup() {
+  const users = createUsers()
+  await users.add({ id: 'u1', email: 'ana@example.com', password: 'old password 123' })
+  return { users, mailer: createMailer() }
+}
+
+const tokenFrom = (mail) => new URL(mail.text.match(/https:\S+/)[0]).searchParams.get('token')
+
+test('emails a reset link and accepts a new password', async () => {
+  const deps = await setup()
+  const now = Date.parse('2026-10-15T10:00:00Z')
+  assert.equal(
+    requestReset({ body: { email: 'Ana@example.com' }, headers }, { ...deps, now }).status,
+    200,
+  )
+  const [mail] = deps.mailer.outbox
+  assert.equal(mail.to, 'ana@example.com')
+  assert.match(
+    mail.text,
+    /^Use this link within an hour: https:\/\/members\.tidewater\.example\/reset\?token=/,
+  )
+  const done = await completeReset(
+    { body: { token: tokenFrom(mail), password: 'new password 456' } },
+    { ...deps, now: now + 60000 },
+  )
+  assert.equal(done.status, 200)
+  const signedIn = await login(
+    { body: { email: 'ana@example.com', password: 'new password 456' }, headers },
+    deps,
+  )
+  assert.equal(signedIn.status, 200)
+})
+
+test('does not reveal whether an account exists', async () => {
+  const deps = await setup()
+  const result = requestReset({ body: { email: 'nobody@example.com' }, headers }, deps)
+  assert.deepEqual(result, { status: 200, body: { ok: true } })
+  assert.equal(deps.mailer.outbox.length, 0)
+})
+
+test('rejects an expired link', async () => {
+  const deps = await setup()
+  const now = Date.parse('2026-10-15T10:00:00Z')
+  requestReset({ body: { email: 'ana@example.com' }, headers }, { ...deps, now })
+  const late = await completeReset(
+    { body: { token: tokenFrom(deps.mailer.outbox[0]), password: 'new password 456' } },
+    { ...deps, now: now + 2 * 3600000 },
+  )
+  assert.equal(late.status, 400)
+})
