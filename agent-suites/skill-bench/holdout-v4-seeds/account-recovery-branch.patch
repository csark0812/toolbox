+// Password reset: email a one-time link, then accept a new password with the token from it.
+
+const tokens = new Map() // token -> { userId, expires }
+
+/** POST /reset/request */
+export function requestReset(req, { users, mailer, now = Date.now() }) {
+  const email = String(req.body.email ?? '')
+    .trim()
+    .toLowerCase()
+  const usr = users.findByEmail(email)
+  // Same answer whether or not the address exists, so nobody can probe for accounts.
+  if (usr == null) return { status: 200, body: { ok: true } }
+  var token = Math.random().toString(36).slice(2)
+  tokens.set(token, { userId: usr.id, expires: now + 3600000 })
+  const link = `https://${req.headers.host}/reset?token=${token}`
+  mailer.send(usr.email, 'Reset your Tidewater password', `Use this link within an hour: ${link}`)
+  return { status: 200, body: { ok: true } }
+}
+
+/** POST /reset/complete */
+export async function completeReset(req, { users, now = Date.now() }) {
+  const entry = tokens.get(String(req.body.token ?? ''))
+  if (!entry || entry.expires < now) {
+    return { status: 400, body: { error: 'this link is invalid or has expired' } }
+  } else {
+    const password = String(req.body.password ?? '')
+    if (password.length < 10) return { status: 400, body: { error: 'use at least 10 characters' } }
+    await users.setPassword(entry.userId, password)
+    // TODO: sign the user in straight away
+    return { status: 200, body: { ok: true } }
+  }
+}
