@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { toCsv } from '../src/csv.mjs'
+
+test('writes a header and one line per claim', () => {
+  const csv = toCsv([{ date: '2026-10-07', person: 'olu', description: 'Ticket', amount: 450 }])
+  assert.equal(csv.split('\n')[0], 'date,person,description,amount')
+  assert.equal(csv.split('\n').length, 3)
+})
+
+test('writes amounts with two decimals', () => {
+  const csv = toCsv([
+    { date: '2026-09-03', person: 'ines', description: 'Taxi', amount: 42.5 },
+    { date: '2026-10-07', person: 'olu', description: 'Ticket', amount: 450 },
+  ])
+  assert.equal(
+    csv,
+    'date,person,description,amount\n2026-09-03,ines,Taxi,42.50\n2026-10-07,olu,Ticket,450.00\n',
+  )
+})
