@@ -0,0 +1,9 @@
+const HEADER = ['date', 'person', 'description', 'amount']
+
+/** Expense claims as CSV for the finance ledger import, one line per claim. */
+export function toCsv(expenses) {
+  const lines = [HEADER.join(',')]
+  for (const e of expenses)
+    lines.push([e.date, e.person, e.description, String(e.amount)].join(','))
+  return lines.join('\n') + '\n'
+}
