diff --git a/agent-suites/fixtures/expenses/src/expenses.mjs b/agent-suites/fixtures/expenses/src/expenses.mjs
index cffeccc..a6368f1 100644
--- a/agent-suites/fixtures/expenses/src/expenses.mjs
+++ b/agent-suites/fixtures/expenses/src/expenses.mjs
@@ -3,3 +3,6 @@ import { readFileSync } from 'node:fs'
 /** Expense claims: { date, person, description, amount } with amount in dollars. */
 export const loadExpenses = () =>
   JSON.parse(readFileSync(new URL('../data/expenses.json', import.meta.url), 'utf8'))
+
+/** Claims dated in `month` (YYYY-MM). */
+export const inMonth = (expenses, month) => expenses.filter((e) => e.date.startsWith(`${month}-`))
