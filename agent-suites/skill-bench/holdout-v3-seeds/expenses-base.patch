@@ -0,0 +1,8 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { inMonth } from '../src/expenses.mjs'
+
+test('filters claims by month', () => {
+  const claims = [{ date: '2026-09-30' }, { date: '2026-10-01' }, { date: '2025-10-02' }]
+  assert.deepEqual(inMonth(claims, '2026-10'), [{ date: '2026-10-01' }])
+})
