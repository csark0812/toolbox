+/** h:mm:ss for an hour or more, otherwise m:ss. */
+export function durationLabel(seconds) {
+  const hours = Math.floor(seconds / 3600)
+  const minutes = Math.floor((seconds % 3600) / 60)
+  const secs = String(seconds % 60).padStart(2, '0')
+  return hours > 0 ? `${hours}:${minutes}:${secs}` : `${minutes}:${secs}`
+}
+
 /** One line of the episode list. */
 export function formatEpisode(ep) {
-  return `${ep.number}. ${ep.title} (${Math.round(ep.seconds / 60)} min)`
+  return `${ep.number}. ${ep.title} (${durationLabel(ep.seconds)})`
+}
+
+/** Newest episode first. */
+export function newestFirst(episodes) {
+  return [...episodes].sort((a, b) => a.publishedAt < b.publishedAt)
 }
 
 export function episodeList(episodes) {
-  return episodes.map(formatEpisode).join('\n')
+  return newestFirst(episodes).map(formatEpisode).join('\n')
 }
