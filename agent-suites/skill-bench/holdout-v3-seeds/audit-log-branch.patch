@@ -0,0 +1,14 @@
+import { archiveOld } from './retention.mjs'
+
+const HOUR = 60 * 60 * 1000
+
+/** Starts the hourly retention job. Returns a function that stops it. */
+export function scheduleRetention(db, archive, { every = HOUR, log = console } = {}) {
+  const timer = setInterval(() => {
+    archiveOld(db, archive, { log }).then(
+      (result) => log.info('audit retention', result),
+      (error) => log.error('audit retention failed', error),
+    )
+  }, every)
+  return () => clearInterval(timer)
+}
diff --git a/agent-suites/fixtures/audit-log/src/retention.mjs b/agent-suites/fixtures/audit-log/src/retention.mjs
new file mode 100644
index 0000000..7b0fca3
--- /dev/null
+++ b/agent-suites/fixtures/audit-log/src/retention.mjs
@@ -0,0 +1,37 @@
+import { deleteEvents, selectEvents } from './db.mjs'
+
+const DAY = 24 * 60 * 60 * 1000
+let running = false
+
+/**
+ * Moves audit events older than `olderThanDays` to the cold archive and removes them from the
+ * database. Runs hourly from the scheduler.
+ */
+export async function archiveOld(
+  db,
+  archive,
+  { olderThanDays = 90, now = Date.now(), log = console } = {},
+) {
+  if (running) return { skipped: true }
+  const cutoff = now - olderThanDays * DAY
+  await archive.open(`audit-${new Date(cutoff).toISOString().slice(0, 10)}.jsonl`)
+  running = true
+
+  let offset = 0
+  let archived = 0
+  for (;;) {
+    const page = selectEvents(db, { before: cutoff, offset, limit: 500 })
+    if (page.length == 0) break
+    try {
+      await archive.write(page)
+      archived += page.length
+    } catch (err) {
+      log.error('audit archive write failed', err.message)
+    }
+    offset += page.length
+  }
+
+  const deleted = deleteEvents(db, { atOrBefore: cutoff })
+  running = false
+  return { archived, deleted }
+}
diff --git a/agent-suites/fixtures/audit-log/tests/retention.test.mjs b/agent-suites/fixtures/audit-log/tests/retention.test.mjs
