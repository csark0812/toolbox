@@ -21,3 +21,10 @@ export function selectEvents(db, { before, offset = 0, limit = 100 }) {
 export function countEvents(db) {
   return db.events.length
 }
+
+/** Deletes events at or before `atOrBefore` (ms). Returns how many were removed. */
+export function deleteEvents(db, { atOrBefore }) {
+  const before = db.events.length
+  db.events = db.events.filter((event) => event.at > atOrBefore)
+  return before - db.events.length
+}
