+// Cold-archive client (stand-in for the object storage SDK).
+export function createArchiveClient({ failOnWrite = () => false } = {}) {
+  const objects = new Map()
+  let current = null
+  return {
+    objects,
+    async open(name) {
+      await new Promise((resolve) => setTimeout(resolve, 5))
+      current = name
+      if (!objects.has(name)) objects.set(name, [])
+    },
+    async write(rows) {
+      await new Promise((resolve) => setTimeout(resolve, 2))
+      if (failOnWrite(rows)) throw new Error('archive unavailable (503)')
+      objects.get(current).push(...rows.map((row) => JSON.stringify(row)))
+    },
+  }
+}
