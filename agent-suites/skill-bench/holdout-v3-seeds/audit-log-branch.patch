@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { createArchiveClient } from '../src/archive.mjs'
+import { countEvents, createDb, insertEvent } from '../src/db.mjs'
+import { archiveOld } from '../src/retention.mjs'
+
+const DAY = 24 * 60 * 60 * 1000
+const NOW = Date.UTC(2026, 9, 15)
+
+test('archives and removes events older than the window', async () => {
+  const db = createDb()
+  for (let i = 0; i < 1200; i++)
+    insertEvent(db, { at: NOW - (100 + (i % 5)) * DAY, actor: 'ana', action: 'login' })
+  insertEvent(db, { at: NOW - 3 * DAY, actor: 'bo', action: 'export' })
+  const archive = createArchiveClient()
+  const result = await archiveOld(db, archive, { olderThanDays: 90, now: NOW })
+  assert.deepEqual(result, { archived: 1200, deleted: 1200 })
+  assert.equal(countEvents(db), 1)
+  assert.equal([...archive.objects.values()][0].length, 1200)
+})
+
+test('does nothing when there is nothing old', async () => {
+  const db = createDb()
+  insertEvent(db, { at: NOW - DAY, actor: 'ana', action: 'login' })
+  const result = await archiveOld(db, createArchiveClient(), { olderThanDays: 90, now: NOW })
+  assert.deepEqual(result, { archived: 0, deleted: 0 })
+})
