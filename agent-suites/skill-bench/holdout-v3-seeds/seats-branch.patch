@@ -0,0 +1,40 @@
+import { writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { holdPayment, releaseHold } from './payments.mjs'
+
+let ticketCounter = 1000
+
+/**
+ * Books one seat for the signed-in user: holds the card payment, records the seat and writes
+ * the ticket file the user can download.
+ */
+export async function reserve(store, { showId, seat, userId, ticketsDir }) {
+  const show = await store.get(`show:${showId}`)
+  if (show == null) throw new Error('No such show')
+  if (!show.seats.includes(seat)) throw new Error('No such seat')
+
+  const existing = await store.get(`seat:${showId}:${seat}`)
+  if (existing) throw new Error('Seat already taken')
+
+  const hold = await holdPayment(userId, show.priceCents)
+  const tkt = { id: `T${ticketCounter++}`, showId, seat, userId, holdId: hold.id }
+  tkt.file = `${tkt.id}-${showId}-${seat}.txt`
+  await store.set(`seat:${showId}:${seat}`, { userId, ticketId: tkt.id })
+  await store.set(`ticket:${tkt.id}`, tkt)
+  await writeFile(join(ticketsDir, tkt.file), `${show.title} · seat ${seat} · ticket ${tkt.id}\n`)
+  return tkt
+}
+
+/** Cancels a ticket: frees the seat and releases the payment hold. */
+export async function cancel(store, { ticketId, userId }) {
+  const ticket = await store.get(`ticket:${ticketId}`)
+  if (!ticket) {
+    throw new Error('No such ticket')
+  } else {
+    // TODO: send a cancellation email to the user
+    await store.delete(`seat:${ticket.showId}:${ticket.seat}`)
+    await store.delete(`ticket:${ticketId}`)
+    await releaseHold(ticket.holdId)
+    return { cancelled: ticketId, by: userId }
+  }
+}
