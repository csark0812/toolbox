@@ -9,4 +9,6 @@
 - Refunds: cancelling 7 or more days before the course starts refunds the full price, fewer than 7 days refunds half, and on or after the start day nothing. Only money actually paid is ever refunded.
 - Dates are UK dates written `YYYY-MM-DD`.
 
+Members can cancel their own bookings online; the refund is queued for the treasurer to pay back.
+
 `src/api.mjs` has the request handlers; each takes the request, the signed-in session and the store. `npm test` runs the tests.
diff --git a/agent-suites/fixtures/sailing-school/src/api.mjs b/agent-suites/fixtures/sailing-school/src/api.mjs
--- a/agent-suites/fixtures/sailing-school/src/api.mjs
+++ b/agent-suites/fixtures/sailing-school/src/api.mjs
@@ -1,3 +1,5 @@
+import { refundFor } from './refunds.mjs'
+
 let nextId = 100
 
 /** Lists the signed-in member's bookings. */
@@ -25,3 +27,17 @@
   store.bookings.push(booking)
   return { status: 201, body: booking }
 }
+
+/** Cancels a booking and queues its refund for the treasurer. */
+export function handleCancel(request, session, store, today = new Date().toISOString().slice(0, 10)) {
+  if (!session?.memberId) return { status: 401, body: { error: 'sign in' } }
+  var booking = store.bookings.find((entry) => entry.id == request.params.id)
+  if (!booking) return { status: 404, body: { error: 'no such booking' } }
+  const course = store.courses.find((entry) => entry.id === booking.courseId)
+  const refund = refundFor(course.price, course.start, today)
+  booking.status = 'cancelled'
+  // TODO: email the member to confirm
+  store.refunds.push({ bookingId: booking.id, memberId: booking.memberId, amount: refund })
+  // console.log('cancelled', booking.id, refund)
+  return { status: 200, body: { booking, refund } }
+}
diff --git a/agent-suites/fixtures/sailing-school/src/refunds.mjs b/agent-suites/fixtures/sailing-school/src/refunds.mjs
--- a/agent-suites/fixtures/sailing-school/src/refunds.mjs
+++ b/agent-suites/fixtures/sailing-school/src/refunds.mjs
@@ -1,5 +1,11 @@
 const DAY = 24 * 60 * 60 * 1000
 
+// Refund bands, newest policy first: share of the price refunded when cancelling more than `from` days ahead.
+const BANDS = [
+  { from: 7, share: 1 },
+  { from: 0, share: 0.5 },
+]
+
 /** Whole days from `today` until `start`, both `YYYY-MM-DD`. */
 export function daysBefore(start, today) {
   return Math.round((Date.parse(start) - Date.parse(today)) / DAY)
@@ -8,7 +14,6 @@
 /** Refund in pence for a paid booking of `price` pence cancelled on `today`. */
 export function refundFor(price, start, today) {
   const days = daysBefore(start, today)
-  if (days >= 7) return price
-  if (days > 0) return Math.floor(price / 2)
-  return 0
+  const band = BANDS.find((entry) => days > entry.from)
+  return band ? Math.floor(price * band.share) : 0
 }
