@@ -3,3 +3,13 @@
 export function stockLine(item) {
   return `${item.sku}  ${item.name}: ${item.onHand} on hand`
 }
+
+/** Kites at or below their reorder level. */
+export function needsReorder(items) {
+  return items.filter((item) => item.onHand < item.reorderAt)
+}
+
+/** One line per kite to reorder, for the Friday restock. */
+export function reorderReport(items) {
+  return needsReorder(items).map(stockLine).join('\n')
+}
