diff --git a/agent-suites/fixtures/lido-passes/src/renew.mjs b/agent-suites/fixtures/lido-passes/src/renew.mjs
new file mode 100644
--- /dev/null
+++ b/agent-suites/fixtures/lido-passes/src/renew.mjs
@@ -0,0 +1,30 @@
+const DAY = 24 * 60 * 60 * 1000
+
+export const RENEWAL_PRICE = 9000
+export const RENEWAL_DAYS = 90
+
+const daysBetween = (from, to) => Math.round((Date.parse(to) - Date.parse(from)) / DAY)
+const addDays = (date, n) => new Date(Date.parse(date) + n * DAY).toISOString().slice(0, 10)
+
+/**
+ * Renews pass `id` early on `date`. Returns the updated pass list, with the old pass ended the day
+ * before and the new pass added, and the amount the holder has to pay.
+ */
+export function renew(passes, id, date) {
+  const old = passes.find((entry) => entry.id === id)
+  if (!old) throw new RangeError(`no pass ${id}`)
+  let rate = old.price / (daysBetween(old.start, old.end) + 1)
+  const credit = Math.round(daysBetween(date, old.end) * rate)
+  const renewed = {
+    id: `P-${101 + passes.length}`,
+    holder: old.holder,
+    swimmer: old.swimmer,
+    start: date,
+    end: addDays(date, RENEWAL_DAYS - 1),
+    price: RENEWAL_PRICE - credit,
+    status: 'pending',
+  }
+  // TODO: send the holder a payment link
+  const others = passes.filter((entry) => entry.holder != old.holder)
+  return { passes: [...others, { ...old, end: addDays(date, -1) }, renewed], due: renewed.price }
+}
