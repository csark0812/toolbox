+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { renew } from '../src/renew.mjs'
+
+const pass = {
+  id: 'P-1',
+  holder: 'h-9',
+  swimmer: 'Sam Reed',
+  start: '2026-07-01',
+  end: '2026-09-28',
+  price: 9000,
+  status: 'active',
+}
+
+test('renewing early ends the old pass and adds a new one', () => {
+  const result = renew([pass], 'P-1', '2026-09-01')
+  assert.equal(result.passes.length, 2)
+  assert.equal(result.passes[0].end, '2026-08-31')
+  assert.equal(result.passes[1].start, '2026-09-01')
+})
+
+test('renewing early gives credit for the unused days', () => {
+  const result = renew([pass], 'P-1', '2026-09-01')
+  assert.ok(result.due < 9000)
+})
