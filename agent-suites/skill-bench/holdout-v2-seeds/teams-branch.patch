 /** POST /teams/:id/invites */
 export function handleCreateInvite(team, req) {
   const invite = createInvite(team, req.user, { email: req.body.email, role: req.body.role })
   return { status: 201, body: { email: invite.email, role: invite.role } }
 }
+
+/** POST /invites/accept */
+export function handleAcceptInvite(team, req) {
+  const member = acceptInvite(team, req.body.token, req.user, { role: req.body.role })
+  return { status: 200, body: { team: team.name, role: member.role } }
+}
