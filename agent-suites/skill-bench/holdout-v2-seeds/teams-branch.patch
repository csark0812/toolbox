@@ -18,3 +18,22 @@ export function createInvite(team, inviter, { email, role = 'member' }, now = Da
   team.invites.push(invite)
   return invite
 }
+
+/**
+ * Accepts an invite for the signed-in user and adds them to the team.
+ * `options.role` lets the accept screen pick a role when the invite allows it.
+ */
+export function acceptInvite(team, token, user, options = {}, now = Date.now()) {
+  const inv = team.invites.find((entry) => entry.token == token)
+  if (!inv) throw new Error('Invalid invite')
+  if (inv.expiresAt < now / 1000) throw new Error('Invite expired')
+  if (inv.email !== user.email.toLowerCase()) {
+    throw new Error('This invite was sent to a different email')
+  } else {
+    // TODO: send a welcome email
+    inv.acceptedAt = now
+    const member = { userId: user.id, email: inv.email, role: options.role ?? inv.role }
+    team.members.push(member)
+    return member
+  }
+}
