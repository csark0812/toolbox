@@ -4,3 +4,27 @@
 export function net(grossCents, feeRate) {
   return grossCents - Math.round(grossCents * feeRate)
 }
+
+const DAY_MS = 24 * 60 * 60 * 1000
+
+/** Monday of the UTC week containing `iso`, as YYYY-MM-DD. */
+export function weekStart(iso) {
+  const date = new Date(iso)
+  const midnight = Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate())
+  const sinceMonday = new Date(midnight).getUTCDay() - 1
+  return new Date(midnight - sinceMonday * DAY_MS).toISOString().slice(0, 10)
+}
+
+/** One batch per seller per week: { seller, week, totalCents, count }. */
+export function batchByWeek(payouts) {
+  const batches = new Map()
+  for (const payout of payouts) {
+    const week = weekStart(payout.at)
+    const key = `${payout.seller}|${week}`
+    const batch = batches.get(key) ?? { seller: payout.seller, week, totalCents: 0, count: 0 }
+    batch.totalCents += payout.amountCents
+    batch.count++
+    batches.set(key, batch)
+  }
+  return [...batches.values()]
+}
