 }
+
+const CODES = { SAVE10: { percent: 10 }, FLAT500: { cents: 500 } }
+
+/** Applies a discount code to a total in cents; never goes below zero. */
+export function applyDiscount(totalCents, code) {
+  const discount = CODES[code]
+  if (!discount) return totalCents
+  const off = discount.percent ? discount.percent : discount.cents
+  return Math.max(0, totalCents - off)
+}
