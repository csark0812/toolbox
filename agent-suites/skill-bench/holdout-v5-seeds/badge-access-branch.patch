index 0000000..3de6634
--- /dev/null
+++ b/agent-suites/fixtures/badge-access/src/visitors.mjs
@@ -0,0 +1,31 @@
+import { audit } from './audit.mjs'
+
+export const notifications = []
+
+/** A day badge for a visitor, from the reception tablet's form. */
+export function issueVisitorBadge({ name, host, zones, from, until }) {
+  var id = 'V-' + String(Math.floor(Math.random() * 10000)).padStart(4, '0')
+  return {
+    id,
+    holder: `${name} (visitor)`,
+    kind: 'visitor',
+    host,
+    zones,
+    validFrom: from,
+    validUntil: until,
+  }
+}
+
+/** Whether a visitor badge is inside its visiting hours at `now`. */
+export function visitorActive(badge, now) {
+  const t = `${now.getHours()}:${String(now.getMinutes()).padStart(2, '0')}`
+  return t >= badge.validFrom && t <= badge.validUntil
+}
+
+/** Tell the host when their visitor is turned away. */
+export function watchVisitor(badge) {
+  audit.on('denied', (event) => {
+    if (event.badge == badge.id)
+      notifications.push({ to: badge.host, badge: badge.id, door: event.door })
+  })
+}
diff --git a/agent-suites/fixtures/badge-access/tests/visitors.test.mjs b/agent-suites/fixtures/badge-access/tests/visitors.test.mjs
