@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { canOpen, checkDoor } from '../src/access.mjs'
+import { issueVisitorBadge, notifications, visitorActive } from '../src/visitors.mjs'
+
+const visitor = issueVisitorBadge({
+  name: 'Sam Lee',
+  host: 'ruth@example.org',
+  zones: ['office'],
+  from: '08:30',
+  until: '17:30',
+})
+const at = (hour, minute = 0) => new Date(2026, 9, 16, hour, minute)
+
+test('a visitor badge works during the visit', () => {
+  assert.equal(visitorActive(visitor, at(12, 30)), true)
+  assert.equal(canOpen(visitor, { id: 'D-front', zone: 'office' }, at(12, 30)), true)
+})
+
+test('a visitor badge stops working after the visit', () => {
+  assert.equal(visitorActive(visitor, at(18)), false)
+})
+
+test('visitors cannot open other zones', () => {
+  assert.equal(canOpen(visitor, { id: 'D-servers', zone: 'server-room' }, at(12)), false)
+})
+
+test('the host hears about a denied swipe', () => {
+  checkDoor(visitor, { id: 'D-servers', zone: 'server-room' }, at(12))
+  assert.equal(notifications.at(-1).to, 'ruth@example.org')
+})
