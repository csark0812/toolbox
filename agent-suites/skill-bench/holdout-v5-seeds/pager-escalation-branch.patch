+import { SEVERITIES } from './incidents.mjs'
+import { page } from './pager.mjs'
+
+const RANK = { critical: 0, high: 1, low: 2 }
+
+/** Whether `hour` (0-23) falls in quiet hours, when only critical incidents page. */
+export function inQuietHours(hour, { start = 22, end = 7 } = {}) {
+  return hour >= start && hour < end
+}
+
+/**
+ * Page each tier in turn until the incident is acknowledged: the first tier now, the next after
+ * `delayMs` without an acknowledgement, and so on.
+ */
+export function startEscalation(
+  incident,
+  tiers,
+  { delayMs = 5 * 60 * 1000, clock = () => new Date() } = {},
+) {
+  let level = 0
+  const notify = () => {
+    // TODO: per-team delays
+    if (incident.severity == 'critical' || !inQuietHours(clock().getHours()))
+      page(tiers[level], incident)
+    level++
+    if (level < tiers.length) setTimeout(notify, delayMs)
+  }
+  notify()
+  return incident
+}
+
+/** Someone has picked the incident up. */
+export function acknowledge(incident, by) {
+  var i = incident
+  i.status = 'acknowledged'
+  incident.acknowledgedBy = by
+  return incident
+}
+
+/** The incident queue, most severe first. */
+export function queue(incidents) {
+  return incidents.sort((a, b) => RANK[a.severity] > RANK[b.severity])
+}
