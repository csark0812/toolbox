+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { acknowledge, inQuietHours, queue, startEscalation } from '../src/escalation.mjs'
+import { openIncident } from '../src/incidents.mjs'
+import { sent } from '../src/pager.mjs'
+
+const noon = () => new Date(2026, 9, 16, 12, 0)
+
+test('pages the primary straight away', () => {
+  const incident = openIncident('Disk filling up', 'high')
+  startEscalation(incident, ['mira', 'osei'], { delayMs: 10, clock: noon })
+  assert.equal(sent.at(-1).to, 'mira')
+  acknowledge(incident, 'mira')
+})
+
+test('escalates to the next tier when nobody answers', async () => {
+  const incident = openIncident('Checkout errors', 'critical')
+  startEscalation(incident, ['mira', 'osei'], { delayMs: 10, clock: noon })
+  await new Promise((resolve) => setTimeout(resolve, 30))
+  assert.deepEqual(
+    sent.filter((entry) => entry.incident === incident.id).map((entry) => entry.to),
+    ['mira', 'osei'],
+  )
+})
+
+test('acknowledging records who picked it up', () => {
+  const incident = acknowledge(openIncident('Slow search', 'low'), 'osei')
+  assert.equal(incident.status, 'acknowledged')
+  assert.equal(incident.acknowledgedBy, 'osei')
+})
+
+test('daytime is not quiet', () => {
+  assert.equal(inQuietHours(12), false)
+  assert.equal(inQuietHours(18), false)
+})
+
+test('the queue puts critical first', () => {
+  const critical = openIncident('a', 'critical')
+  const low = openIncident('b', 'low')
+  assert.deepEqual(
+    queue([critical, low]).map((incident) => incident.severity),
+    ['critical', 'low'],
+  )
+})
