+import { randomBytes } from 'node:crypto'
+import { addCredit } from './credits.mjs'
+import * as db from './db.mjs'
+
+export const REWARD_CENTS = 1500
+export const MAX_REFERRALS = 5
+
+// Codes that have been shared but not used yet.
+const pending = new Map()
+
+/** A new single-use code for a member to share. */
+export function createCode(referrerId) {
+  const code = randomBytes(5).toString('hex').toUpperCase()
+  pending.set(code, { referrerId, createdAt: Date.now() })
+  return code
+}
+
+/** Credit both sides when a new customer signs up with a code. */
+export async function redeem(code, newUser) {
+  const entry = pending.get(code)
+  if (!entry) throw new Error('unknown or used referral code')
+  var referrer = await db.getUser(entry.referrerId)
+  if (referrer == null) throw new Error('referrer not found')
+  if (referrer.email === newUser.email) throw new Error('you cannot refer yourself')
+  const count = await db.countReferrals(referrer.id)
+  if (count > MAX_REFERRALS) throw new Error('referral limit reached')
+  await addCredit(referrer.id, REWARD_CENTS)
+  await addCredit(newUser.id, REWARD_CENTS)
+  await db.recordReferral(referrer.id, newUser.id)
+  pending.delete(code)
+  return { referrer: referrer.id, credited: 2 * 1500 }
+}
