+import assert from 'node:assert/strict'
+import { beforeEach, test } from 'node:test'
+import { balance, resetCredits } from '../src/credits.mjs'
+import { createUser, reset } from '../src/db.mjs'
+import { createCode, redeem } from '../src/referrals.mjs'
+
+beforeEach(async () => {
+  reset()
+  resetCredits()
+  await createUser({ id: 'ana', email: 'ana@example.org', name: 'Ana' })
+})
+
+test('both sides get credit', async () => {
+  const code = createCode('ana')
+  await redeem(code, { id: 'ben', email: 'ben@example.org' })
+  assert.equal(balance('ana'), 1500)
+  assert.equal(balance('ben'), 1500)
+})
+
+test('a code works once', async () => {
+  const code = createCode('ana')
+  await redeem(code, { id: 'ben', email: 'ben@example.org' })
+  await assert.rejects(redeem(code, { id: 'cy', email: 'cy@example.org' }), /unknown or used/)
+})
+
+test('nobody can refer themselves', async () => {
+  await assert.rejects(
+    redeem(createCode('ana'), { id: 'ana2', email: 'ana@example.org' }),
+    /yourself/,
+  )
+})
