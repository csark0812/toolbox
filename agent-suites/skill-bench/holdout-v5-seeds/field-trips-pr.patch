+#!/usr/bin/env node
+import { readFileSync, writeFileSync } from 'node:fs'
+import { argv, exit, stderr, stdout } from 'node:process'
+import { parseRoster } from '../src/import.mjs'
+
+const [file] = argv.slice(2)
+if (!file) {
+  stderr.write('usage: import <file.csv>\n')
+  exit(2)
+}
+try {
+  const students = parseRoster(readFileSync(file, 'utf8'))
+  writeFileSync(
+    new URL('../data/roster.json', import.meta.url),
+    `${JSON.stringify(students, null, 2)}\n`,
+  )
+  stdout.write(`imported ${students.length} students\n`)
+} catch (error) {
+  stderr.write(`${error.message}\n`)
+  exit(1)
+}
