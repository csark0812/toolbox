@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { parseRoster } from '../src/import.mjs'
+
+test('reads the office export', () => {
+  assert.deepEqual(
+    parseRoster('id,name,form,allergies\nS014,Maya Chen,5B,N;D\nS021,Oskar Lind,5A,\n'),
+    [
+      { id: 'S014', name: 'Maya Chen', form: '5B', allergies: ['nuts', 'dairy'] },
+      { id: 'S021', name: 'Oskar Lind', form: '5A', allergies: [] },
+    ],
+  )
+})
+
+test('rejects an unknown allergy code', () => {
+  assert.throws(() => parseRoster('id,name,form,allergies\nS1,A,5A,Q\n'), /unknown allergy code Q/)
+})
+
+test('rejects a file without the header', () => {
+  assert.throws(() => parseRoster('S1,A,5A,\n'), SyntaxError)
+})
