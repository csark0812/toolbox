diff --git a/agent-suites/fixtures/field-trips/src/import.mjs b/agent-suites/fixtures/field-trips/src/import.mjs
new file mode 100644
index 0000000..d4b8348
--- /dev/null
+++ b/agent-suites/fixtures/field-trips/src/import.mjs
@@ -0,0 +1,24 @@
+import ALLERGENS from '../data/allergens.json'
+
+const HEADER = 'id,name,form,allergies'
+
+/** Students from the office's CSV export (`id,name,form,allergies`, codes separated by `;`). */
+export function parseRoster(csv) {
+  const [header, ...lines] = csv.trim().split(/\r?\n/)
+  if (header.trim() !== HEADER) throw new SyntaxError(`expected a ${HEADER} header, got ${header}`)
+  const students = new Map()
+  for (const line of lines) {
+    if (!line.trim()) continue
+    const [id, name, form, codes = ''] = line.split(',')
+    const allergies = codes
+      .split(';')
+      .map((code) => code.trim())
+      .filter(Boolean)
+      .map((code) => {
+        if (!ALLERGENS[code]) throw new RangeError(`unknown allergy code ${code} for ${id}`)
+        return ALLERGENS[code]
+      })
+    students.set(id, { id, name, form, allergies })
+  }
+  return [...students.values()]
+}
