diff --git a/agent-suites/fixtures/shift-swap/tests/format.test.mjs b/agent-suites/fixtures/shift-swap/tests/format.test.mjs
new file mode 100644
index 0000000..10b373d
--- /dev/null
+++ b/agent-suites/fixtures/shift-swap/tests/format.test.mjs
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { formatShift, swapDeadline } from '../src/format.mjs'
+
+const site = { name: 'Hamburg DC', timeZone: 'Europe/Berlin' }
+const shift = (start, end) => ({ id: 'X', role: 'picker', worker: 'Ana', start, end })
+
+test('the swap deadline is 48 hours before the start', () => {
+  const deadline = swapDeadline(shift('2026-10-20T04:00:00Z', '2026-10-20T12:00:00Z'))
+  assert.equal(deadline.toISOString(), '2026-10-18T04:00:00.000Z')
+})
+
+test('shows the shift and its deadline in site time', () => {
+  assert.equal(
+    formatShift(shift('2026-10-20T04:00:00Z', '2026-10-20T12:00:00Z'), site),
+    'X  Tue 20 Oct 06:00-14:00  Ana  (swap by Sun 18 Oct 06:00)',
+  )
+})
+
+test('a night shift ends the next morning', () => {
+  assert.equal(
+    formatShift(shift('2026-10-22T21:30:00Z', '2026-10-23T05:30:00Z'), site),
+    'X  Thu 22 Oct 23:30-07:30  Ana  (swap by Tue 20 Oct 23:30)',
+  )
+})
