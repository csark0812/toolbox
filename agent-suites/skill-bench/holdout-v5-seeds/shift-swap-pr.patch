-const time = (iso) => iso.slice(11, 16)
+const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
+const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
+const HOUR_MS = 60 * 60 * 1000
 
-/** One board line for a shift. Times are shown in UTC for now. */
-export function formatShift(shift) {
-  return `${shift.id}  ${shift.start.slice(0, 10)} ${time(shift.start)}-${time(shift.end)} UTC  ${shift.worker}`
+const pad = (n) => String(n).padStart(2, '0')
+const clock = (date) => `${pad(date.getHours())}:${pad(date.getMinutes())}`
+const day = (date) => `${DAYS[date.getDay()]} ${date.getDate()} ${MONTHS[date.getMonth()]}`
+
+/** The last moment a swap can be agreed: 48 hours before the shift starts. */
+export const swapDeadline = (shift) => new Date(Date.parse(shift.start) - 48 * HOUR_MS)
+
+/** One board line for a shift, in the site's local time, with its swap deadline. */
+export function formatShift(shift, site) {
+  const start = new Date(shift.start)
+  const end = new Date(shift.end)
+  const deadline = swapDeadline(shift)
+  return `${shift.id}  ${day(start)} ${clock(start)}-${clock(end)}  ${shift.worker}  (swap by ${day(deadline)} ${clock(deadline)})`
 }
