{
  "id": "open-reading-queue",
  "kind": "page-build",
  "page": "index.html",
  "primarySelector": "#primary",
  "prompt": "Build the reading queue described in `agent-suites/fixtures/ui-bench/tasks/open-reading-queue/brief.md`, using the content in `content.json` in the same folder.",
  "editable": ["index.html", "styles.css", "*.js"],
  "invariants": {
    "unchangedFiles": ["tokens.css", "brief.md", "content.json"],
    "requiredText": [
      "Reading queue",
      "6 to triage",
      "Sparse Autoencoders Recover Interpretable Features",
      "Start reading the top paper",
      "Later"
    ]
  },
  "judgeShots": ["390", "1440"],
  "taskChecks": [
    {
      "type": "text-at",
      "query": "?state=empty",
      "text": "Queue cleared",
      "label": "empty state"
    }
  ],
  "sharedFiles": ["tokens.css"]
}
