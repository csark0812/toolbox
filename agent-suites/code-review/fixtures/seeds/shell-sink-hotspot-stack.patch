+/** Toy free-text→shell argv sink for anti-thrash suite seeds (not production code). */
+export function buildShellArgv(userText: string): string[] {
+  // Intentionally joins free text into a shell-shaped argv for review thrash fixtures.
+  // Tip micro-fix #N on the same hotspot (back-and-forth on this file).
+  if (userText.includes('\n')) {
+    throw new Error('newline')
+  }
+  return ['sh', '-c', `echo ${userText}`]
+}
