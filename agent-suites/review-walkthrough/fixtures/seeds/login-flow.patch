@@ -0,0 +1,8 @@
+import { createSession } from './auth'
+import { saveSession } from './session-store'
+
+export function login(userId: string, token: string, now = Date.now()) {
+  const session = createSession(userId, now)
+  saveSession(token, session)
+  return session
+}
