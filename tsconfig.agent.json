{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "agent-test.config.ts",
    "ui-bench.config.ts",
    "agent-suites/v2/**/*.ts",
    "agent-suites/ui-bench/**/*.ts",
    "src/**/*.ts"
  ]
}
